{
  "uid": "iam-overview",
  "title": "IAM Overview",
  "schemaVersion": 39,
  "version": 2,
  "refresh": "30s",
  "timezone": "browser",
  "tags": [
    "iam",
    "logs"
  ],
  "links": [
    {
      "asDropdown": false,
      "icon": "external link",
      "includeVars": true,
      "keepTime": true,
      "tags": [],
      "targetBlank": false,
      "title": "Open Error Center",
      "tooltip": "Open grouped IAM errors for the same environment and service filter",
      "type": "link",
      "url": "/d/iam-error-center/iam-error-center?orgId=1&${__url_time_range}&var-env=$env&var-service=$service"
    },
    {
      "asDropdown": false,
      "icon": "external link",
      "includeVars": true,
      "keepTime": true,
      "tags": [],
      "targetBlank": false,
      "title": "Open Request Drilldown",
      "tooltip": "Open request-level log drilldown",
      "type": "link",
      "url": "/d/iam-request-drilldown/iam-request-drilldown?orgId=1&${__url_time_range}&var-env=$env&var-service=$service&var-requestId=.*&var-traceId=.*"
    }
  ],
  "templating": {
    "list": [
      {
        "name": "env",
        "type": "query",
        "datasource": {
          "type": "loki",
          "uid": "iam-loki"
        },
        "query": "label_values(env)",
        "current": {
          "text": "dev",
          "value": "dev"
        }
      },
      {
        "name": "service",
        "type": "query",
        "datasource": {
          "type": "loki",
          "uid": "iam-loki"
        },
        "query": "label_values({env=\"$env\"}, service)",
        "includeAll": true,
        "current": {
          "text": "All",
          "value": "$__all"
        },
        "allValue": ".*"
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "title": "Total log lines",
      "type": "stat",
      "datasource": {
        "type": "loki",
        "uid": "iam-loki"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(count_over_time({env=\"$env\", service=~\"$service\"}[$__range]))"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "unit": "short",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "blue",
                "value": 0
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "values": false,
          "calcs": [
            "lastNotNull"
          ],
          "fields": ""
        },
        "orientation": "auto",
        "textMode": "auto",
        "wideLayout": true,
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "auto",
        "showPercentChange": false
      },
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 0,
        "y": 0
      }
    },
