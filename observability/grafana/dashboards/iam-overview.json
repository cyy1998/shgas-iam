    {
      "id": 11,
      "title": "Recent error summary",
      "type": "logs",
      "datasource": {
        "type": "loki",
        "uid": "iam-loki"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "{env=\"$env\", service=~\"$service\", level=~\"error|fatal\"} | json | __error__=\"\" | line_format \"{{.service}} | {{.event}} | {{.errorName}}{{.errorCode}} | requestId={{.requestId}} traceId={{.traceId}} | {{.errorMessage}}{{.msg}}\""
        }
      ],
      "options": {
        "showTime": true,
        "showLabels": false,
        "showCommonLabels": false,
        "wrapLogMessage": true,
        "prettifyLogMessage": false,
        "enableLogDetails": true,
        "dedupStrategy": "none",
        "sortOrder": "Descending"
      },
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "gridPos": {
        "h": 7,
        "w": 24,
        "x": 0,
        "y": 20
      }
    },
