    {
      "id": 5,
      "title": "P95 duration",
      "type": "stat",
      "datasource": {
        "type": "loki",
        "uid": "iam-loki"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "max(quantile_over_time(0.95, {env=\"$env\", service=~\"$service\"} | json | __error__=\"\" | durationMs != \"\" | unwrap durationMs | __error__=\"\" [$__range]))"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "unit": "ms",
          "thresholds": {
            "mode": "absolute",
            "steps": [
