{
  "uid": "iam-request-drilldown",
  "title": "IAM Request Drilldown",
  "schemaVersion": 39,
  "version": 5,
  "refresh": "10s",
  "timezone": "browser",
  "tags": [
    "iam",
    "logs",
    "request"
  ],
  "links": [
    {
      "asDropdown": false,
      "icon": "external link",
      "includeVars": true,
      "keepTime": true,
      "tags": [],
      "targetBlank": false,
      "title": "Open Overview",
      "tooltip": "Return to IAM log health overview",
      "type": "link",
      "url": "/d/iam-overview/iam-overview?orgId=1&${__url_time_range}&var-env=$env&var-service=$service"
    },
    {
      "asDropdown": false,
      "icon": "external link",
      "includeVars": true,
      "keepTime": true,
      "tags": [],
      "targetBlank": false,
      "title": "Open Error Center",
      "tooltip": "Open grouped IAM errors for the same environment and service filter",
      "type": "link",
      "url": "/d/iam-error-center/iam-error-center?orgId=1&${__url_time_range}&var-env=$env&var-service=$service"
    }
  ],
  "templating": {
    "list": [
      {
        "name": "env",
        "type": "textbox",
        "current": {
          "text": "dev",
          "value": "dev"
        }
      },
      {
        "name": "service",
        "type": "query",
        "datasource": {
          "type": "loki",
          "uid": "iam-loki"
        },
        "query": "label_values({env=\"$env\"}, service)",
        "includeAll": true,
        "multi": true,
        "allValue": ".*",
        "current": {
          "text": "All",
          "value": "$__all"
        }
      },
      {
        "name": "requestId",
        "type": "textbox",
        "current": {
          "text": ".*",
          "value": ".*"
        }
      },
      {
        "name": "traceId",
        "type": "textbox",
        "current": {
          "text": ".*",
          "value": ".*"
        }
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "title": "Correlation",
      "type": "text",
      "datasource": {
        "type": "loki",
        "uid": "iam-loki"
      },
      "options": {
        "mode": "markdown",
        "content": "**Request ID:** `$requestId`\n\n**Trace ID:** `$traceId`\n\n**Environment:** `$env`    **Service filter:** `$service`"
      },
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "gridPos": {
        "h": 4,
        "w": 8,
        "x": 0,
        "y": 0
      }
    },
    {
      "id": 2,
      "title": "Timeline entries",
      "type": "stat",
      "datasource": {
        "type": "loki",
        "uid": "iam-loki"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(count_over_time({env=\"$env\", service=~\"$service\"} | json | __error__=\"\" | requestId=~\"$requestId\" | traceId=~\"$traceId\" [$__range]))"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "unit": "short",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "blue",
                "value": 0
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "values": false,
          "calcs": [
            "lastNotNull"
          ],
          "fields": ""
        },
        "orientation": "auto",
        "textMode": "auto",
        "wideLayout": true,
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "auto",
        "showPercentChange": false
      },
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 8,
        "y": 0
      }
    },
    {
      "id": 3,
      "title": "Services involved",
      "type": "stat",
      "datasource": {
        "type": "loki",
        "uid": "iam-loki"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "count(sum by (service) (count_over_time({env=\"$env\", service=~\"$service\"} | json | __error__=\"\" | requestId=~\"$requestId\" | traceId=~\"$traceId\" [$__range])))"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "unit": "short",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "green",
                "value": 0
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "values": false,
          "calcs": [
            "lastNotNull"
          ],
          "fields": ""
        },
        "orientation": "auto",
        "textMode": "auto",
        "wideLayout": true,
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "auto",
        "showPercentChange": false
      },
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 12,
        "y": 0
      }
    },
    {
      "id": 4,
      "title": "Error entries",
      "type": "stat",
      "datasource": {
        "type": "loki",
        "uid": "iam-loki"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(count_over_time({env=\"$env\", service=~\"$service\", level=~\"error|fatal\"} | json | __error__=\"\" | requestId=~\"$requestId\" | traceId=~\"$traceId\" [$__range]))"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "unit": "short",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "values": false,
          "calcs": [
            "lastNotNull"
          ],
          "fields": ""
        },
        "orientation": "auto",
        "textMode": "auto",
        "wideLayout": true,
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "auto",
        "showPercentChange": false
      },
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 16,
        "y": 0
      }
    },
    {
      "id": 5,
      "title": "Max duration",
      "type": "stat",
      "datasource": {
        "type": "loki",
        "uid": "iam-loki"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "max(max_over_time({env=\"$env\", service=~\"$service\"} | json | __error__=\"\" | requestId=~\"$requestId\" | traceId=~\"$traceId\" | durationMs != \"\" | unwrap durationMs | __error__=\"\" [$__range]))"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "unit": "ms",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "yellow",
                "value": 500
              },
              {
                "color": "red",
                "value": 1500
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "values": false,
          "calcs": [
            "lastNotNull"
          ],
          "fields": ""
        },
        "orientation": "auto",
        "textMode": "auto",
        "wideLayout": true,
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "auto",
        "showPercentChange": false
      },
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 20,
        "y": 0
      }
    },
    {
      "id": 6,
      "title": "Structured request timeline",
      "type": "table",
      "datasource": {
        "type": "loki",
        "uid": "iam-loki"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "{env=\"$env\", service=~\"$service\"} | json | __error__=\"\" | requestId=~\"$requestId\" | traceId=~\"$traceId\"",
          "format": "logs"
        }
      ],
      "transformations": [
        {
          "id": "extractFields",
          "options": {
            "source": "Line",
            "format": "json",
            "replace": false
          }
        },
        {
          "id": "organize",
          "options": {
            "indexByName": {
              "Time": 0,
              "service": 1,
              "event": 2,
              "method": 3,
              "path": 4,
              "route": 5,
              "statusCode": 6,
              "durationMs": 7,
              "upstreamStatus": 8,
              "upstreamAddr": 9,
              "errorName": 10,
              "errorCode": 11,
              "errorMessage": 12,
              "msg": 13,
              "requestId": 14,
              "traceId": 15
            },
            "renameByName": {
              "Time": "Time",
              "service": "Service",
              "event": "Event",
              "method": "Method",
              "path": "Path",
              "route": "Route",
              "statusCode": "Status",
              "durationMs": "Duration (ms)",
              "upstreamStatus": "Upstream status",
              "upstreamAddr": "Upstream address",
              "errorName": "Error type",
              "errorCode": "Error code",
              "errorMessage": "Error message",
              "msg": "Message",
              "requestId": "Request ID",
              "traceId": "Trace ID"
            },
            "excludeByName": {
              "Line": true,
              "labels": true,
              "id": true,
              "Time_ns": true,
              "tsNs": true
            }
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "custom": {
            "align": "auto",
            "cellOptions": {
              "type": "auto"
            },
            "inspect": false
          },
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Time"
            },
            "properties": [
              {
                "id": "custom.width",
                "value": 180
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Service"
            },
            "properties": [
              {
                "id": "custom.width",
                "value": 130
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Event"
            },
            "properties": [
              {
                "id": "custom.width",
                "value": 230
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Method"
            },
            "properties": [
              {
                "id": "custom.width",
                "value": 85
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Path"
            },
            "properties": [
              {
                "id": "custom.width",
                "value": 360
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Status"
            },
            "properties": [
              {
                "id": "custom.width",
                "value": 90
              },
              {
                "id": "unit",
                "value": "short"
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Duration (ms)"
            },
            "properties": [
              {
                "id": "custom.width",
                "value": 110
              },
              {
                "id": "unit",
                "value": "ms"
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Request ID"
            },
            "properties": [
              {
                "id": "custom.width",
                "value": 260
              },
              {
                "id": "links",
                "value": [
                  {
                    "title": "Open this request",
                    "url": "/d/iam-request-drilldown/iam-request-drilldown?orgId=1&${__url_time_range}&var-env=$env&var-service=${__data.fields.service}&var-requestId=${__data.fields.requestId}&var-traceId=${__data.fields.traceId}",
                    "targetBlank": false
                  }
                ]
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Trace ID"
            },
            "properties": [
              {
                "id": "custom.width",
                "value": 220
              },
              {
                "id": "links",
                "value": [
                  {
                    "title": "Open this trace",
                    "url": "/d/iam-request-drilldown/iam-request-drilldown?orgId=1&${__url_time_range}&var-env=$env&var-service=${__data.fields.service}&var-requestId=${__data.fields.requestId}&var-traceId=${__data.fields.traceId}",
                    "targetBlank": false
                  }
                ]
              }
            ]
          },
          {
            "matcher": {
              "id": "byRegexp",
              "options": "Status|Upstream status"
            },
            "properties": [
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "color-background"
                }
              }
            ]
          }
        ]
      },
      "options": {
        "showHeader": true,
        "cellHeight": "sm",
        "footer": {
          "show": false,
          "reducer": [
            "sum"
          ],
          "countRows": false,
          "fields": ""
        }
      },
      "gridPos": {
        "h": 12,
        "w": 24,
        "x": 0,
        "y": 4
      }
    },
    {
      "id": 7,
      "title": "Readable timeline",
      "type": "logs",
      "datasource": {
        "type": "loki",
        "uid": "iam-loki"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "{env=\"$env\", service=~\"$service\"} | json | __error__=\"\" | requestId=~\"$requestId\" | traceId=~\"$traceId\" | line_format \"{{.service}} | {{.event}} | {{.method}} {{.path}} | status={{.statusCode}} duration={{.durationMs}}ms | upstream={{.upstreamStatus}} {{.upstreamAddr}} | error={{.errorName}}{{.errorCode}} {{.errorMessage}}{{.msg}}\""
        }
      ],
      "options": {
        "showTime": true,
        "showLabels": false,
        "showCommonLabels": false,
        "wrapLogMessage": true,
        "prettifyLogMessage": false,
        "enableLogDetails": true,
        "dedupStrategy": "none",
        "sortOrder": "Ascending"
      },
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "gridPos": {
        "h": 8,
        "w": 24,
        "x": 0,
        "y": 16
      }
    },
    {
      "id": 8,
      "title": "Raw request logs",
      "type": "logs",
      "datasource": {
        "type": "loki",
        "uid": "iam-loki"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "{env=\"$env\", service=~\"$service\"} | json | __error__=\"\" | requestId=~\"$requestId\" | traceId=~\"$traceId\""
        }
      ],
      "options": {
        "showTime": true,
        "showLabels": false,
        "showCommonLabels": false,
        "wrapLogMessage": false,
        "prettifyLogMessage": false,
        "enableLogDetails": true,
        "dedupStrategy": "none",
        "sortOrder": "Ascending"
      },
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "gridPos": {
        "h": 8,
        "w": 24,
        "x": 0,
        "y": 24
      }
    }
  ]
}
