{
  "name": "iam-monorepo",
  "packageManager": "pnpm@12.21.0",
  "private": true,
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "turbo dev",
    "build": "turbo build",
    "prepare": "node .husky/install.mjs",
    "format": "biome format --write . && prettier \"**/*.{less,md,yaml,yml}\" --no-error-on-unmatched-pattern --write",
    "format:check": "biome format . && prettier \"**/*.{less,md,yaml,yml}\" --no-error-on-unmatched-pattern --check",
    "lint": "biome check --formatter-enabled=false . && stylelint \"**/*.less\" --allow-empty-input",
    "lint:fix": "biome check --formatter-enabled=false --write . && stylelint \"**/*.less\" --allow-empty-input",
    "check": "node scripts/verify.mjs --check",
    "fix": "pnpm format && pnpm lint:fix",
    "test": "pnpm test:unit",
    "test:unit": "node scripts/require-linux.mjs && pnpm test:unit:sandcastle && turbo test:unit --concurrency=2",
    "test:unit:sandcastle": "bun test ./.sandcastle/__tests__",
    "test:integration": "node scripts/run-test-integration.mjs",
    "test:e2e": "pnpm --filter @iam/e2e-system test:e2e",
    "test:e2e:managed": "pnpm --filter @iam/e2e-system test:e2e:managed",
    "e2e:install": "pnpm --filter @iam/admin exec playwright install --with-deps chromium",
    "e2e:install:browsers": "pnpm --filter @iam/admin exec playwright install chromium",
    "typecheck": "turbo typecheck typecheck:root --concurrency=1",
    "typecheck:root": "tsc --project .sandcastle/tsconfig.json && tsc --project scripts/tsconfig.json",
    "sandcastle": "flock -n .sandcastle/runner.lock node .sandcastle/run.mts",
    "sandcastle:check": "node .sandcastle/run.mts --check",
    "sandcastle:build": "node .sandcastle/run.mts --build",
    "sandcastle:smoke": "node .sandcastle/run.mts --smoke",
    "check:architecture": "bun scripts/check-architecture.ts",
    "check:docs": "bun scripts/check-docs-index.ts",
    "check:env-names": "bun scripts/check-env-names.ts",
    "verify": "node scripts/verify.mjs",
    "test:resources:cleanup": "node scripts/run-test-resource-cleanup.mjs"
  },
  "devDependencies": {
    "@ai-hero/sandcastle": "0.14.0",
    "@biomejs/biome": "^2.6.8",
    "@iam/runtime": "workspace:*",
    "@types/bun": "1.4.4",
    "@types/node": "^24.13.6",
    "@typescript/native": "npm:typescript@7.0.2",
    "github-slugger": "2.0.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.1",
    "markdown-it": "15.0.3",
    "postcss-less": "^6.0.0",
    "prettier": "^3.10.1",
    "smol-toml": "1.9.1",
    "stylelint": "^17.16.0",
    "stylelint-config-standard": "^40.0.0",
    "tsx": "4.23.15",
    "turbo": "^2.11.11",
    "typescript": "npm:@typescript/typescript6@6.0.2"
  }
}
