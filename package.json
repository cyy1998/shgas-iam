{
  "name": "iam-monorepo",
  "packageManager": "pnpm@12.5.1",
  "private": true,
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "turbo dev",
    "build": "turbo build",
    "prepare": "node .husky/install.mjs",
    "format": "biome format --write . && prettier \"**/*.{less,md,yaml,yml}\" --no-error-on-unmatched-pattern --write",
    "format:check": "biome format . && prettier \"**/*.{less,md,yaml,yml}\" --no-error-on-unmatched-pattern --check",
    "lint": "biome check --formatter-enabled=false . && stylelint \"**/*.less\" --allow-empty-input",
    "lint:fix": "biome check --formatter-enabled=false --write . && stylelint \"**/*.less\" --allow-empty-input",
    "test": "pnpm test:unit",
    "test:unit": "turbo test:unit test:unit:root --concurrency=2",
    "test:unit:root": "bun test --max-concurrency=2 scripts/sandcastle/__tests__ scripts/tooling/__tests__",
    "test:integration": "node scripts/run-test-integration.mjs",
    "test:e2e": "turbo test:e2e --concurrency=1",
    "e2e:install": "pnpm --filter @iam/admin exec playwright install --with-deps chromium",
    "e2e:install:browsers": "pnpm --filter @iam/admin exec playwright install chromium",
    "typecheck": "turbo typecheck typecheck:root --concurrency=3",
    "typecheck:root": "tsc --project scripts/sandcastle/tsconfig.json && tsc --project scripts/test-entry.tsconfig.json",
    "sandcastle": "tsx scripts/sandcastle/main.mts",
    "sandcastle:check": "tsx scripts/sandcastle/main.mts --check",
    "sandcastle:build": "tsx scripts/sandcastle/main.mts --build",
    "sandcastle:smoke": "tsx scripts/sandcastle/main.mts --smoke",
    "check:architecture": "bun scripts/check-architecture.ts",
    "check:docs": "bun scripts/check-docs-index.ts",
    "check:env-names": "bun scripts/check-env-names.ts",
    "verify": "node scripts/verify.mjs",
    "verify:static": "node scripts/verify.mjs --static",
    "verify:ci": "node scripts/run-verification-gate.mjs ci",
    "verify:release": "node scripts/run-verification-gate.mjs release",
    "test:resources:cleanup": "node scripts/run-test-resource-cleanup.mjs",
    "test:integration:bun:root": "node scripts/run-package-integration.mjs bun -- bun test scripts/test-integration"
  },
  "devDependencies": {
    "@ai-hero/sandcastle": "0.12.0",
    "@biomejs/biome": "^2.5.14",
    "@iam/api-core": "workspace:*",
    "@types/bun": "1.4.2",
    "@types/node": "^24.13.6",
    "@typescript/native": "npm:typescript@7.0.2",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "postcss-less": "^6.0.0",
    "prettier": "^3.9.9",
    "smol-toml": "1.8.0",
    "stylelint": "^17.15.0",
    "stylelint-config-standard": "^40.0.0",
    "tsx": "4.23.15",
    "turbo": "^2.10.5",
    "typescript": "npm:@typescript/typescript6@6.0.2"
  },
  "iamTest": {
    "integration": {
      "bun": {}
    }
  }
}
