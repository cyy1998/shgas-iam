{
  "name": "iam-monorepo",
  "packageManager": "pnpm@11.5.0",
  "private": true,
  "scripts": {
    "dev": "turbo dev",
    "build": "turbo build",
    "lint": "turbo lint",
    "lint:fix": "turbo lint:fix",
    "test": "turbo test",
    "e2e": "turbo e2e",
    "typecheck": "turbo typecheck",
    "check:docs": "bun scripts/check-docs-index.ts",
    "check:env-names": "bun scripts/check-env-names.ts",
    "gateway:apisix": "pnpm --filter @iam/gateway-apisix apisix",
    "gateway:apisix:validate": "pnpm --filter @iam/gateway-apisix validate",
    "gateway:apisix:diff": "pnpm --filter @iam/gateway-apisix diff",
    "gateway:apisix:apply": "pnpm --filter @iam/gateway-apisix apply"
  },
  "devDependencies": {
    "turbo": "^2.9.16"
  }
}
