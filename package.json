{
  "name": "iam-monorepo",
  "packageManager": "pnpm@11.14.0",
  "private": true,
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "turbo dev",
    "build": "turbo build",
    "prepare": "node .husky/install.mjs",
    "lint": "turbo lint && eslint --config eslint.root.config.mjs scripts eslint.root.config.mjs eslint.frontend.config.mjs stylelint.frontend.config.mjs && pnpm check:workflow",
    "lint:fix": "turbo lint:fix && eslint --config eslint.root.config.mjs --fix scripts eslint.root.config.mjs eslint.frontend.config.mjs stylelint.frontend.config.mjs",
    "test": "turbo test",
    "test:workflow": "bun test scripts/__tests__/check-workflow.test.ts",
    "e2e": "turbo e2e",
    "e2e:install": "pnpm --filter @iam/admin exec playwright install --with-deps chromium",
    "e2e:install:browsers": "pnpm --filter @iam/admin exec playwright install chromium",
    "typecheck": "turbo typecheck",
    "check:docs": "bun scripts/check-docs-index.ts",
    "check:env-names": "bun scripts/check-env-names.ts",
    "check:workflow": "bun scripts/check-workflow.ts",
    "gateway:apisix": "pnpm --filter @iam/gateway-apisix apisix",
    "gateway:apisix:validate": "pnpm --filter @iam/gateway-apisix validate",
    "gateway:apisix:diff": "pnpm --filter @iam/gateway-apisix diff",
    "gateway:apisix:apply": "pnpm --filter @iam/gateway-apisix apply"
  },
  "devDependencies": {
    "@antfu/eslint-config": "^9.1.0",
    "eslint": "^10.7.0",
    "eslint-plugin-format": "^2.0.1",
    "husky": "^9.1.7",
    "turbo": "^2.10.5",
    "@typescript/native": "npm:typescript@7.0.2",
    "typescript": "npm:@typescript/typescript6@6.0.2"
  }
}
