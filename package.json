{
  "name": "iam-monorepo",
  "packageManager": "pnpm@11.14.0",
  "private": true,
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "turbo dev",
    "build": "turbo build",
    "prepare": "node .husky/install.mjs",
    "lint": "turbo lint lint:root",
    "lint:root": "eslint --config eslint.root.config.mjs scripts eslint.root.config.mjs eslint.frontend.config.mjs stylelint.frontend.config.mjs",
    "lint:fix": "turbo lint:fix lint:fix:root",
    "lint:fix:root": "eslint --config eslint.root.config.mjs --fix scripts eslint.root.config.mjs eslint.frontend.config.mjs stylelint.frontend.config.mjs",
    "test": "turbo test --concurrency=2",
    "test:external": "turbo test:external --concurrency=1",
    "test:smoke": "turbo test:smoke --concurrency=1",
    "e2e": "turbo e2e",
    "e2e:install": "pnpm --filter @iam/admin exec playwright install --with-deps chromium",
    "e2e:install:browsers": "pnpm --filter @iam/admin exec playwright install chromium",
    "typecheck": "turbo typecheck --concurrency=3",
    "check:architecture": "bun scripts/check-architecture.ts",
    "check:docs": "bun scripts/check-docs-index.ts",
    "check:env-names": "bun scripts/check-env-names.ts",
    "gateway:apisix": "pnpm --filter @iam/gateway-apisix apisix",
    "gateway:apisix:validate": "pnpm --filter @iam/gateway-apisix validate",
    "gateway:apisix:diff": "pnpm --filter @iam/gateway-apisix diff",
    "gateway:apisix:apply": "pnpm --filter @iam/gateway-apisix apply",
    "verify": "node scripts/verify.mjs"
  },
  "devDependencies": {
    "@iam/eslint-config": "workspace:*",
    "eslint": "^10.7.0",
    "husky": "^9.1.7",
    "turbo": "^2.10.5",
    "@typescript/native": "npm:typescript@7.0.2",
    "typescript": "npm:@typescript/typescript6@6.0.2"
  }
}
