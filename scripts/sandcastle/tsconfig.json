{
  "compilerOptions": {
    "target": "ESNext",
    "module": "Preserve",
    "moduleResolution": "bundler",
    "types": ["bun", "node"],
    "allowImportingTsExtensions": true,
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noEmit": true,
    "verbatimModuleSyntax": true,
    "skipLibCheck": true
  },
  "include": ["./core/**/*.ts", "./core/**/*.mts", "../../.sandcastle/**/*.ts", "../../.sandcastle/**/*.mts"],
  "exclude": [
    "../../.sandcastle/logs/**",
    "../../.sandcastle/resources/**",
    "../../.sandcastle/state/**",
    "../../.sandcastle/worktrees/**"
  ]
}
