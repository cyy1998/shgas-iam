generator client {
  provider        = "prisma-client-js"
  output          = "../generated/prisma"
  previewFeatures = ["views"]
}

datasource db {
  provider     = "mysql"
  url          = env("DATABASE_URL")
  relationMode = "prisma"
}

model User {
  id          Int      @id @default(autoincrement()) @map("id")
  username    String   @unique @map("username") @db.VarChar(64)
  wxId        String?  @db.VarChar(255)
  name        String   @map("name") @db.VarChar(64)
  password    String?  @map("password") @db.VarChar(255)
  mobilePhone String?  @map("mobile_phone") @db.VarChar(20)
  userType    String   @default("正式员工") @map("user_type") @db.VarChar(20)
  orderNum    Int      @default(999999) @map("order_num")
  status      Int      @default(1) @map("status") @db.TinyInt
  isDelete    Boolean  @default(false) @map("is_delete") @db.TinyInt
  createTime  DateTime @default(now()) @map("create_time") @db.DateTime(0)
  updateTime  DateTime @default(now()) @map("update_time") @db.DateTime(0)

  employments    Employment[]
  delegationTo   PrivilegeDelegation[] @relation("delegationTo")
  delegationFrom PrivilegeDelegation[] @relation("delegationFrom")

  // @@index([username], map: "idx_username")
  // @@index([userType], map: "idx_userType")
  @@map("user")
}

model Organization {
  id               Int      @id @default(autoincrement()) @map("id")
  orgCode          String   @unique @map("org_code")
  orgName          String   @map("org_name")
  parentId         Int?     @default(-1) @map("parent_id")
  businessParentId Int      @default(-1) @map("business_parent_id")
  path             String   @map("path")
  level            Int      @map("level")
  orgType          String   @map("org_type")
  orderNum         Int      @default(0) @map("order_num")
  isVirtual        Boolean  @default(false) @map("is_virtual")
  isEntity         Boolean  @default(false) @map("is_entity")
  status           Int      @default(1) @map("status")
  isDelete         Boolean  @default(false) @map("is_delete")
  createTime       DateTime @default(now()) @map("create_time")
  updateTime       DateTime @default(now()) @updatedAt @map("update_time")

  deptEmployments   Employment[]          @relation("employment_dept")
  compEmployments   Employment[]          @relation("employment_comp")
  roles             OrganizationRole[]
  posOrgComposition PosOrgComposition[]
  parent            Organization?         @relation("org_parent", fields: [parentId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  children          Organization[]        @relation("org_parent")
  // 反向关系：该组织作为祖先时的闭包记录
  ancestorClosures  OrganizationClosure[] @relation("org_ancestor")

  // 反向关系：该组织作为后代时的闭包记录
  descendantClosures OrganizationClosure[] @relation("org_descendant")

  @@index([parentId], map: "idx_parentId")
  // @@index([orgCode], map: "idx_orgCode")
  @@map("organization")
}

model OrganizationClosure {
  id           Int @id @default(autoincrement())
  ancestorId   Int @map("ancestor_id") // 祖先组织 ID
  descendantId Int @map("descendant_id") // 后代组织 ID
  depth        Int @map("depth") // 从 ancestor 到 descendant 的层级深度（0 表示自己）

  // 关联到祖先组织
  ancestor   Organization @relation("org_ancestor", fields: [ancestorId], references: [id])
  // 关联到后代组织
  descendant Organization @relation("org_descendant", fields: [descendantId], references: [id])

  @@unique([ancestorId, descendantId])
  @@index([ancestorId])
  @@index([descendantId])
  @@map("organization_closure")
}

model Position {
  id          Int      @id @default(autoincrement()) @map("id")
  posCode     String   @unique @map("post_code") @db.VarChar(64)
  posName     String   @map("post_name") @db.VarChar(128)
  status      Int      @default(1) @map("status") @db.TinyInt
  description String?  @map("description") @db.VarChar(500)
  isDelete    Boolean  @default(false) @map("is_delete") @db.TinyInt
  createTime  DateTime @default(now()) @map("create_time")
  updateTime  DateTime @default(now()) @updatedAt @map("update_time")

  employments       Employment[]
  roles             PositionRole[]
  posOrgComposition PosOrgComposition[]

  // @@index([posCode], map: "idx_posCode")
  @@map("position")
}

model PosOrgComposition {
  id          Int      @id @default(autoincrement()) @map("id")
  posId       Int      @map("pos_id")
  orgId       Int      @map("org_id")
  status      Int      @default(1) @map("status") @db.TinyInt
  description String?  @map("description") @db.VarChar(500)
  isDelete    Boolean  @default(false) @map("is_delete") @db.TinyInt
  createTime  DateTime @default(now()) @map("create_time")
  updateTime  DateTime @default(now()) @updatedAt @map("update_time")

  position     Position     @relation(fields: [posId], references: [id])
  organization Organization @relation(fields: [orgId], references: [id])
  employments  Employment[]
  roles        PosOrgRole[]

  @@unique([posId, orgId])
  @@index([orgId], map: "idx_org_id")
  @@map("pos_org_composition")
}

model Employment {
  id          Int       @id @default(autoincrement()) @map("id")
  userId      Int       @map("user_id")
  posId       Int       @map("pos_id")
  deptId      Int       @map("dept_id")
  compId      Int       @map("comp_id")
  isPrimary   Boolean   @default(false) @map("is_primary") @db.TinyInt
  status      Int       @default(1) @map("status") @db.TinyInt
  startTime   DateTime  @default(now()) @map("start_time")
  endTime     DateTime? @map("end_time")
  description String?   @map("description") @db.VarChar(500)
  isDelete    Boolean   @default(false) @map("is_delete") @db.TinyInt
  createTime  DateTime  @default(now()) @map("create_time")
  updateTime  DateTime  @default(now()) @updatedAt @map("update_time")

  user        User              @relation(fields: [userId], references: [id])
  deptartment Organization      @relation("employment_dept", fields: [deptId], references: [id])
  company     Organization      @relation("employment_comp", fields: [compId], references: [id])
  position    Position          @relation(fields: [posId], references: [id])
  posOrg      PosOrgComposition @relation(fields: [posId, deptId], references: [posId, orgId])
  roles       EmploymentRole[]

  @@index([userId], map: "idx_user_id")
  @@index([deptId], map: "idx_dept_id")
  @@index([compId], map: "idx_comp_id")
  @@index([posId], map: "idx_pos_id")
  @@index([posId, deptId], map: "idx_pos_dept_id")
  @@map("employment")
}

model Client {
  id            Int      @id @default(autoincrement()) @map("id")
  clientCode    String   @unique @map("client_code") @db.VarChar(64)
  clientName    String   @map("client_name") @db.VarChar(128)
  url           String?  @map("url") @db.VarChar(128)
  status        Int      @default(1) @map("status") @db.TinyInt
  description   String?  @map("description") @db.VarChar(500)
  isDelete      Boolean  @default(false) @map("is_delete") @db.TinyInt
  createTime    DateTime @default(now()) @map("create_time")
  updateTime    DateTime @default(now()) @updatedAt @map("update_time")
  extAttributes Json     @map("ext_attributes") @db.Json
  roles         Role[]

  @@map("client")
}

model Role {
  id                    Int                @id @default(autoincrement()) @map("id")
  roleCode              String             @unique @map("role_code") @db.VarChar(64)
  roleName              String             @map("role_name") @db.VarChar(128)
  clientId              Int                @map("client_id")
  status                Int                @default(1) @map("status") @db.TinyInt
  description           String?            @map("description") @db.VarChar(500)
  isDelete              Boolean            @default(false) @map("is_delete") @db.TinyInt
  createTime            DateTime           @default(now()) @map("create_time")
  updateTime            DateTime           @default(now()) @updatedAt @map("update_time")
  client                Client             @relation(fields: [clientId], references: [id])
  positions             PositionRole[]
  organizations         OrganizationRole[]
  positionOrganizations PosOrgRole[]
  employments           EmploymentRole[]
  privileges            RolePrivilege[]

  @@index([clientId], map: "idx_client_id")
  // @@index([roleCode], map: "idx_roleCode")
  @@map("role")
}

model PositionRole {
  positionId Int @map("position_id")
  roleId     Int @map("role_id")

  position Position @relation(fields: [positionId], references: [id])
  role     Role     @relation(fields: [roleId], references: [id])

  @@id([positionId, roleId])
  @@index([roleId], map: "idx_role_id")
  @@map("position_role")
}

model EmploymentRole {
  employmentId Int @map("employment_id")
  roleId       Int @map("role_id")

  employment Employment @relation(fields: [employmentId], references: [id])
  role       Role       @relation(fields: [roleId], references: [id])

  @@id([employmentId, roleId])
  @@index([roleId], map: "idx_role_id")
  @@map("employment_role")
}

model OrganizationRole {
  organizationId Int     @map("organization_id")
  roleId         Int     @map("role_id")
  isAllSub       Boolean @default(true) @map("is_all_sub") @db.TinyInt

  organization Organization @relation(fields: [organizationId], references: [id])
  role         Role         @relation(fields: [roleId], references: [id])

  @@id([organizationId, roleId])
  @@index([roleId], map: "idx_role_id")
  @@map("organization_role")
}

model PosOrgRole {
  posOrgId Int @map("pos_org_id")
  roleId   Int @map("role_id")

  posOrg PosOrgComposition @relation(fields: [posOrgId], references: [id])
  role   Role              @relation(fields: [roleId], references: [id])

  @@id([posOrgId, roleId])
  @@index([roleId], map: "idx_role_id")
  @@map("position_organization_role")
}

model Privilege {
  id            Int      @id @default(autoincrement()) @map("id")
  privilegeCode String   @unique @map("privilege_code")
  privilegeName String   @map("privilege_name")
  fieldValues   Json?    @map("field_values")
  status        Int      @default(1) @map("status") @db.TinyInt
  description   String?  @map("description") @db.VarChar(500)
  isDelete      Boolean  @default(false) @map("is_delete") @db.TinyInt
  createTime    DateTime @default(now()) @map("create_time")
  updateTime    DateTime @default(now()) @updatedAt @map("update_time")

  roles       RolePrivilege[]
  delegations DelegationDetail[]

  // @@index([privilegeCode], map: "idx_privilegeCode")
  @@map("privilege")
}

model RolePrivilege {
  roleId      Int       @map("role_id")
  privilegeId Int       @map("privilege_id")
  role        Role      @relation(fields: [roleId], references: [id])
  privilege   Privilege @relation(fields: [privilegeId], references: [id])

  @@id([roleId, privilegeId])
  @@index([privilegeId], map: "idx_privilege_id")
  @@map("role_privilege")
}

model PrivilegeDelegation {
  id              Int      @id @default(autoincrement()) @map("id")
  delegatorUserId Int      @map("delegator_user_id")
  delegateeUserId Int      @map("delegatee_user_id")
  startTime       DateTime @map("start_time")
  endTime         DateTime @map("end_time")
  status          Int      @default(1) @map("status") @db.TinyInt
  description     String?  @map("description") @db.VarChar(500)
  isDelete        Boolean  @default(false) @map("is_delete") @db.TinyInt
  createTime      DateTime @default(now()) @map("create_time")
  updateTime      DateTime @default(now()) @updatedAt @map("update_time")

  delegatorUser     User               @relation("delegationTo", fields: [delegatorUserId], references: [id])
  delegateeUser     User               @relation("delegationFrom", fields: [delegateeUserId], references: [id])
  delegationDetails DelegationDetail[]

  @@index([delegatorUserId, delegateeUserId], map: "idx_delegationTo")
  @@index([delegateeUserId, delegatorUserId], map: "idx_delegationFrom")
  @@map("privilege_delegation")
}

model DelegationDetail {
  delegationId Int @map("delegation_id")
  privilegeId  Int @map("privilege_id")

  delegation PrivilegeDelegation @relation(fields: [delegationId], references: [id])
  privilege  Privilege           @relation(fields: [privilegeId], references: [id])

  @@id([delegationId, privilegeId])
  @@index([privilegeId], map: "idx_privilege")
  @@map("delegation_detail")
}
