{
  "name": "@iam/assignment-resolution",
  "type": "module",
  "version": "0.0.1",
  "private": true,
  "exports": {
    "./employment-lifecycle": "./src/employment-lifecycle.ts",
    "./role-assignment": "./src/role-assignment/index.ts",
    "./organization-responsibility": "./src/organization-responsibility/index.ts",
    "./organization-responsibility/assignment-lifecycle": "./src/organization-responsibility/assignment-lifecycle.ts",
    "./organization-responsibility/assignment-lifecycle-store": "./src/organization-responsibility/assignment-lifecycle-store.ts",
    "./organization-responsibility/parent-lifecycle": "./src/organization-responsibility/parent-lifecycle.ts"
  },
  "scripts": {
    "lint": "biome check --formatter-enabled=false . && stylelint \"**/*.less\" --allow-empty-input",
    "lint:fix": "biome check --formatter-enabled=false --write . && stylelint \"**/*.less\" --allow-empty-input",
    "typecheck": "pnpm exec tsc --noEmit",
    "format": "biome format --write . && prettier \"**/*.{less,md,yaml,yml}\" --ignore-path ../../.gitignore --ignore-path ../../.prettierignore --no-error-on-unmatched-pattern --write",
    "format:check": "biome format . && prettier \"**/*.{less,md,yaml,yml}\" --ignore-path ../../.gitignore --ignore-path ../../.prettierignore --no-error-on-unmatched-pattern --check",
    "test": "pnpm test:unit",
    "test:unit": "bun test --max-concurrency=2 src"
  },
  "dependencies": {
    "@iam/contracts": "workspace:*",
    "@iam/db": "workspace:*",
    "@iam/domain": "workspace:*",
    "drizzle-orm": "1.0.0-rc.2"
  },
  "devDependencies": {
    "@iam/test-support": "workspace:*",
    "@types/bun": "latest",
    "@typescript/native": "npm:typescript@7.0.2",
    "postgres": "^3.4.9",
    "typescript": "npm:@typescript/typescript6@6.0.2"
  },
  "iamTest": {
    "integration": {
      "bun": {
        "postgres": true
      }
    }
  }
}
