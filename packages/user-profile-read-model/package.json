{
  "name": "@iam/user-profile-read-model",
  "type": "module",
  "version": "0.0.1",
  "private": true,
  "exports": {
    ".": "./src/index.ts",
    "./producer": "./src/producer.ts",
    "./query": "./src/query.ts",
    "./query/repository": "./src/query/user-profile-query.repository.ts",
    "./subject-access-transition": "./src/subject-access/subject-access-transition.repository.ts",
    "./subject-facts": "./src/subject-facts.ts",
    "./v3": "./src/v3.ts",
    "./worker": "./src/worker.ts"
  },
  "scripts": {
    "lint": "node ../../scripts/run-quality.mjs lint --workspace packages/user-profile-read-model",
    "lint:fix": "node ../../scripts/run-quality.mjs lint-fix --workspace packages/user-profile-read-model",
    "test": "pnpm test:unit",
    "test:unit": "bun test --max-concurrency=2 src",
    "test:integration:component": "bun test --max-concurrency=2 test-integration/component",
    "test:integration:postgres": "bun test --max-concurrency=1 test-integration/postgres",
    "test:integration:redis": "bun test --max-concurrency=1 test-integration/redis",
    "typecheck": "pnpm exec tsc --noEmit",
    "format": "node ../../scripts/run-quality.mjs format --workspace packages/user-profile-read-model",
    "format:check": "node ../../scripts/run-quality.mjs format-check --workspace packages/user-profile-read-model"
  },
  "dependencies": {
    "@hono/zod-openapi": "^1.5.1",
    "@iam/api-core": "workspace:*",
    "@iam/client-subject-projection": "workspace:*",
    "@iam/contracts": "workspace:*",
    "@iam/db": "workspace:*",
    "@iam/domain": "workspace:*",
    "@iam/jobs": "workspace:*",
    "@iam/organization-responsibility-resolution": "workspace:*",
    "@iam/role-assignment-resolution": "workspace:*",
    "drizzle-orm": "1.0.0-rc.2",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "@typescript/native": "npm:typescript@7.0.2",
    "ioredis": "^6.0.0",
    "postgres": "^3.4.9",
    "typescript": "npm:@typescript/typescript6@6.0.2"
  }
}
