{
  "name": "@iam/user-profile-read-model",
  "type": "module",
  "version": "0.0.1",
  "private": true,
  "exports": {
    ".": "./src/index.ts",
    "./producer": "./src/producer.ts",
    "./query": "./src/query.ts",
    "./query/repository": "./src/user-profile-query.repository.ts",
    "./subject-access-transition": "./src/subject-access-transition.repository.ts",
    "./subject-facts": "./src/subject-facts.ts",
    "./v3": "./src/v3.ts",
    "./worker": "./src/worker.ts"
  },
  "scripts": {
    "lint": "eslint src test-integration eslint.config.js",
    "lint:fix": "eslint --fix src test-integration eslint.config.js",
    "test": "pnpm test:unit",
    "test:unit": "bun test --max-concurrency=2 src",
    "test:integration:component": "bun test --max-concurrency=2 test-integration/component",
    "test:integration:postgres": "bun test --max-concurrency=1 test-integration/postgres",
    "test:integration:redis": "bun test --max-concurrency=1 test-integration/redis",
    "typecheck": "pnpm exec tsc --noEmit"
  },
  "dependencies": {
    "@hono/zod-openapi": "^1.5.1",
    "@iam/api-core": "workspace:*",
    "@iam/client-subject-projection": "workspace:*",
    "@iam/contracts": "workspace:*",
    "@iam/db": "workspace:*",
    "@iam/domain": "workspace:*",
    "@iam/jobs": "workspace:*",
    "@iam/organization-responsibility-resolution": "workspace:*",
    "@iam/role-assignment-resolution": "workspace:*",
    "drizzle-orm": "1.0.0-rc.2",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@iam/eslint-config": "workspace:*",
    "@types/bun": "latest",
    "@typescript/native": "npm:typescript@7.0.2",
    "eslint": "^10.7.0",
    "ioredis": "^5.11.1",
    "postgres": "^3.4.9",
    "typescript": "npm:@typescript/typescript6@6.0.2"
  }
}
