{
  "name": "@iam/db",
  "type": "module",
  "version": "0.0.1",
  "private": true,
  "exports": {
    ".": "./src/index.ts",
    "./schema": "./src/schema/index.ts",
    "./relations": "./src/relations/index.ts",
    "./query-utils": "./src/query-utils.ts"
  },
  "scripts": {
    "lint": "eslint src scripts drizzle.config.ts eslint.config.js",
    "lint:fix": "eslint --fix src scripts drizzle.config.ts eslint.config.js",
    "test": "bun test --parallel",
    "typecheck": "pnpm exec tsgo --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:push": "drizzle-kit push",
    "db:check": "drizzle-kit check",
    "migrate:login-log-audit": "bun scripts/migrate-login-log-to-audit.ts"
  },
  "dependencies": {
    "@iam/contracts": "workspace:*",
    "drizzle-orm": "1.0.0-rc.2",
    "postgres": "^3.4.9",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@antfu/eslint-config": "^9.0.0",
    "@types/bun": "latest",
    "@typescript/native-preview": "7.0.0-dev.20260514.1",
    "drizzle-kit": "1.0.0-rc.2",
    "eslint": "^10.3.0",
    "eslint-plugin-format": "^2.0.1",
    "typescript": "^6.0.3"
  }
}
