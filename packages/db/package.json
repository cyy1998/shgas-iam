{
  "name": "@iam/db",
  "type": "module",
  "version": "0.0.1",
  "private": true,
  "exports": {
    ".": "./src/index.ts",
    "./schema": "./src/schema/public.ts",
    "./schema/role-assignments": "./src/schema/role-assignments.ts",
    "./relations": "./src/relations/index.ts",
    "./query-utils": "./src/query-utils.ts"
  },
  "scripts": {
    "lint": "eslint scripts src test-integration drizzle.config.ts eslint.config.js",
    "lint:fix": "eslint --fix scripts src test-integration drizzle.config.ts eslint.config.js",
    "test": "pnpm test:unit",
    "test:unit": "bun test --max-concurrency=2 src",
    "test:integration:postgres": "bun test --max-concurrency=1 test-integration/postgres",
    "typecheck": "pnpm exec tsc --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:push": "drizzle-kit push",
    "db:check": "drizzle-kit check",
    "subject-projection:rollback": "bun scripts/rollback-subject-projection-cutover.ts"
  },
  "dependencies": {
    "@iam/contracts": "workspace:*",
    "drizzle-orm": "1.0.0-rc.2",
    "postgres": "^3.4.9",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@iam/eslint-config": "workspace:*",
    "@types/bun": "latest",
    "@typescript/native": "npm:typescript@7.0.2",
    "drizzle-kit": "1.0.0-rc.2",
    "eslint": "^10.7.0",
    "typescript": "npm:@typescript/typescript6@6.0.2"
  }
}
