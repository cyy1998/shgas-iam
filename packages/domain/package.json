{
  "name": "@iam/domain",
  "type": "module",
  "version": "0.0.1",
  "private": true,
  "exports": {
    ".": "./src/index.ts",
    "./audit": "./src/audit/index.ts",
    "./audit/*": "./src/audit/*.ts",
    "./client": "./src/client/index.ts",
    "./client/*": "./src/client/*.ts",
    "./employment": "./src/employment/index.ts",
    "./employment/*": "./src/employment/*.ts",
    "./organization": "./src/organization/index.ts",
    "./organization/*": "./src/organization/*.ts",
    "./position": "./src/position/index.ts",
    "./position/*": "./src/position/*.ts",
    "./privilege": "./src/privilege/index.ts",
    "./privilege/*": "./src/privilege/*.ts",
    "./role": "./src/role/index.ts",
    "./role/*": "./src/role/*.ts",
    "./user": "./src/user/index.ts",
    "./user/*": "./src/user/*.ts"
  },
  "scripts": {
    "lint": "eslint src eslint.config.js",
    "lint:fix": "eslint --fix src eslint.config.js",
    "test": "bun test --max-concurrency=2",
    "typecheck": "pnpm exec tsc --noEmit"
  },
  "dependencies": {
    "@hono/zod-openapi": "^1.5.1",
    "@iam/contracts": "workspace:*",
    "@iam/db": "workspace:*",
    "drizzle-orm": "1.0.0-rc.2",
    "tldts": "^7.4.4",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@iam/eslint-config": "workspace:*",
    "@types/bun": "latest",
    "@typescript/native": "npm:typescript@7.0.2",
    "eslint": "^10.7.0",
    "typescript": "npm:@typescript/typescript6@6.0.2"
  }
}
