{
  "name": "@iam/api-core",
  "type": "module",
  "version": "0.0.1",
  "private": true,
  "exports": {
    "./core/create-app": "./src/core/create-app.ts",
    "./core/create-router": "./src/core/create-router.ts",
    "./core/define-config": "./src/core/define-config.ts",
    "./core/openapi/helpers/common-error-responses": "./src/core/openapi/helpers/common-error-responses.ts",
    "./core/openapi/helpers/json-content": "./src/core/openapi/helpers/json-content.ts",
    "./core/openapi/helpers/json-content-required": "./src/core/openapi/helpers/json-content-required.ts",
    "./core/openapi/schemas/create-success-schema": "./src/core/openapi/schemas/create-success-schema.ts",
    "./core/openapi/schemas/error-response-schema": "./src/core/openapi/schemas/error-response-schema.ts",
    "./core/pagination/paginate": "./src/core/pagination/paginate.ts",
    "./core/pagination/schema": "./src/core/pagination/schema.ts",
    "./core/request-context": "./src/core/request-context.ts",
    "./http": "./src/http/response.ts",
    "./http/request-log": "./src/http/request-log.ts",
    "./http/subject-access": "./src/http/subject-access.ts",
    "./middlewares": "./src/middlewares/error-handler.ts",
    "./trpc": "./src/trpc/index.ts",
    "./types": "./src/types/lib.ts"
  },
  "scripts": {
    "lint": "biome check --formatter-enabled=false . && stylelint \"**/*.less\" --allow-empty-input",
    "lint:fix": "biome check --formatter-enabled=false --write . && stylelint \"**/*.less\" --allow-empty-input",
    "test": "pnpm test:unit",
    "test:unit": "bun test --max-concurrency=2 src",
    "typecheck": "pnpm exec tsc --noEmit",
    "format": "biome format --write . && prettier \"**/*.{less,md,yaml,yml}\" --ignore-path ../../.gitignore --ignore-path ../../.prettierignore --no-error-on-unmatched-pattern --write",
    "format:check": "biome format . && prettier \"**/*.{less,md,yaml,yml}\" --ignore-path ../../.gitignore --ignore-path ../../.prettierignore --no-error-on-unmatched-pattern --check"
  },
  "dependencies": {
    "@hono/zod-openapi": "^1.5.1",
    "@iam/contracts": "workspace:*",
    "@iam/runtime": "workspace:*",
    "@iam/subject-access": "workspace:*",
    "@scalar/hono-api-reference": "^0.11.11",
    "@trpc/server": "^11.18.0",
    "hono": "^4.12.30",
    "hono-pino": "^0.10.3",
    "pino": "^10.3.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "@typescript/native": "npm:typescript@7.0.2",
    "typescript": "npm:@typescript/typescript6@6.0.2"
  }
}
