{
  "name": "@iam/api-core",
  "type": "module",
  "version": "0.0.1",
  "private": true,
  "exports": {
    ".": "./src/index.ts",
    "./authorization-grant": "./src/authorization-grant/index.ts",
    "./authorization-grant/testing": "./src/authorization-grant/testing.ts",
    "./core": "./src/core/index.ts",
    "./core/*": "./src/core/*.ts",
    "./client-traffic-gate": "./src/client-traffic-gate/index.ts",
    "./client-runtime-snapshot": "./src/client-runtime-snapshot/index.ts",
    "./client-runtime-snapshot/redis-maintenance": "./src/client-runtime-snapshot/restore-inventory.ts",
    "./client-runtime-snapshot/testing": "./src/client-runtime-snapshot/testing.ts",
    "./errors": "./src/errors/index.ts",
    "./errors/*": "./src/errors/*.ts",
    "./http": "./src/http/index.ts",
    "./http/*": "./src/http/*.ts",
    "./logger": "./src/logger/index.ts",
    "./login-restriction": "./src/login-restriction/index.ts",
    "./middlewares": "./src/middlewares/index.ts",
    "./middlewares/*": "./src/middlewares/*.ts",
    "./observability": "./src/observability/index.ts",
    "./redis": "./src/redis/index.ts",
    "./security": "./src/security/index.ts",
    "./session/kernel": "./src/session/kernel/index.ts",
    "./session/kernel/env-config": "./src/session/kernel/env-config.ts",
    "./session/kernel/testing": "./src/session/kernel/testing.ts",
    "./subject-access": "./src/subject-access/index.ts",
    "./subject-access/testing": "./src/subject-access/testing.ts",
    "./testing/custom-sso-cleanup-redis-harness": "./src/testing/custom-sso-cleanup-redis-harness.ts",
    "./testing/external-test-resources": "./src/testing/external-test-resources.ts",
    "./testing/process-smoke-harness": "./src/testing/process-smoke-harness.ts",
    "./trpc": "./src/trpc/index.ts",
    "./types": "./src/types/lib.ts",
    "./uow": "./src/uow/index.ts",
    "./utils": "./src/utils/index.ts",
    "./utils/*": "./src/utils/*.ts"
  },
  "scripts": {
    "lint": "eslint src test-integration scripts eslint.config.js",
    "lint:fix": "eslint --fix src test-integration scripts eslint.config.js",
    "session:cleanup-custom-sso-cutover": "bun --no-env-file run scripts/cleanup-legacy-session-keys.ts --profile custom-sso-cutover",
    "session:cleanup-legacy-keys": "bun --no-env-file run scripts/cleanup-legacy-session-keys.ts",
    "client-runtime:hard-cutover-redis": "bun test --max-concurrency=1 test-integration/redis/client-runtime-snapshot.integration.test.ts",
    "test": "pnpm test:unit",
    "test:integration:component": "bun test --max-concurrency=2 test-integration/component",
    "test:integration:process": "bun test --max-concurrency=1 test-integration/process",
    "test:integration:redis": "bun test --max-concurrency=1 test-integration/redis",
    "test:unit": "bun test --max-concurrency=2 src",
    "typecheck": "pnpm exec tsc --noEmit"
  },
  "dependencies": {
    "@hono/zod-openapi": "^1.5.1",
    "@iam/contracts": "workspace:*",
    "@scalar/hono-api-reference": "^0.11.11",
    "@trpc/server": "^11.18.0",
    "bcrypt-ts": "^9.0.1",
    "hono": "^4.12.30",
    "hono-pino": "^0.10.3",
    "ioredis": "^5.11.1",
    "pino": "^10.3.1",
    "pino-pretty": "^13.1.3",
    "sm-crypto": "^0.4.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@iam/eslint-config": "workspace:*",
    "@types/bun": "latest",
    "@types/sm-crypto": "^0.3.4",
    "@typescript/native": "npm:typescript@7.0.2",
    "eslint": "^10.7.0",
    "typescript": "npm:@typescript/typescript6@6.0.2"
  }
}
