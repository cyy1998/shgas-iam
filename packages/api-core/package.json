{
  "name": "@iam/api-core",
  "type": "module",
  "version": "0.0.1",
  "private": true,
  "exports": {
    ".": "./src/index.ts",
    "./core": "./src/core/index.ts",
    "./core/*": "./src/core/*.ts",
    "./errors": "./src/errors/index.ts",
    "./errors/*": "./src/errors/*.ts",
    "./http": "./src/http/index.ts",
    "./http/*": "./src/http/*.ts",
    "./logger": "./src/logger/index.ts",
    "./middlewares": "./src/middlewares/index.ts",
    "./middlewares/*": "./src/middlewares/*.ts",
    "./oidc": "./src/oidc/index.ts",
    "./observability": "./src/observability/index.ts",
    "./redis": "./src/redis/index.ts",
    "./security": "./src/security/index.ts",
    "./session/kernel": "./src/session/kernel/index.ts",
    "./trpc": "./src/trpc/index.ts",
    "./types": "./src/types/lib.ts",
    "./uow": "./src/uow/index.ts",
    "./utils": "./src/utils/index.ts",
    "./utils/*": "./src/utils/*.ts"
  },
  "scripts": {
    "lint": "eslint src eslint.config.js",
    "lint:fix": "eslint --fix src eslint.config.js",
    "session:cleanup-legacy-keys": "bun scripts/cleanup-legacy-session-keys.ts",
    "test": "bun test --parallel",
    "typecheck": "pnpm exec tsgo --noEmit"
  },
  "dependencies": {
    "@hono/zod-openapi": "^1.4.0",
    "@iam/contracts": "workspace:*",
    "@scalar/hono-api-reference": "^0.10.20",
    "@trpc/server": "^11.17.0",
    "bcrypt-ts": "^8.0.1",
    "hono": "^4.12.23",
    "hono-pino": "^0.10.3",
    "ioredis": "^5.11.0",
    "pino": "^10.3.1",
    "pino-pretty": "^13.1.3",
    "sm-crypto": "^0.4.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@antfu/eslint-config": "^9.0.0",
    "@types/bun": "latest",
    "@types/sm-crypto": "^0.3.4",
    "@typescript/native-preview": "7.0.0-dev.20260603.1",
    "eslint": "^10.4.1",
    "eslint-plugin-format": "^2.0.1",
    "typescript": "^6.0.3"
  }
}
