{
  "name": "@iam/jobs",
  "type": "module",
  "version": "0.0.1",
  "private": true,
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "lint": "node ../../scripts/run-quality.mjs lint --workspace packages/jobs",
    "lint:fix": "node ../../scripts/run-quality.mjs lint-fix --workspace packages/jobs",
    "test": "pnpm test:unit",
    "test:unit": "bun test --max-concurrency=2 src",
    "typecheck": "pnpm exec tsc --noEmit",
    "format": "node ../../scripts/run-quality.mjs format --workspace packages/jobs",
    "format:check": "node ../../scripts/run-quality.mjs format-check --workspace packages/jobs"
  },
  "dependencies": {
    "bullmq": "^6.3.8",
    "ioredis": "^6.0.0"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "@typescript/native": "npm:typescript@7.0.2",
    "typescript": "npm:@typescript/typescript6@6.0.2"
  }
}
