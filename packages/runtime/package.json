{
  "name": "@iam/runtime",
  "type": "module",
  "version": "0.0.1",
  "private": true,
  "exports": {
    "./env-schema": "./src/env-schema.ts",
    "./errors": "./src/errors/index.ts",
    "./logger": "./src/logger/index.ts",
    "./maintenance": "./src/maintenance/index.ts",
    "./observability": "./src/observability/index.ts",
    "./process": "./src/process/owned-process-tree.mjs",
    "./redis/config": "./src/redis/config.ts",
    "./redis/connection": "./src/redis/connection.ts",
    "./security/bcrypt": "./src/security/bcrypt.ts"
  },
  "scripts": {
    "lint": "biome check --formatter-enabled=false . && stylelint \"**/*.less\" --allow-empty-input",
    "lint:fix": "biome check --formatter-enabled=false --write . && stylelint \"**/*.less\" --allow-empty-input",
    "test": "pnpm test:unit",
    "test:unit": "bun test --max-concurrency=2 src",
    "typecheck": "pnpm exec tsc --noEmit",
    "format": "biome format --write . && prettier \"**/*.{less,md,yaml,yml}\" --ignore-path ../../.gitignore --ignore-path ../../.prettierignore --no-error-on-unmatched-pattern --write",
    "format:check": "biome format . && prettier \"**/*.{less,md,yaml,yml}\" --ignore-path ../../.gitignore --ignore-path ../../.prettierignore --no-error-on-unmatched-pattern --check",
    "test:integration:bun": "node ../../scripts/run-package-integration.mjs bun -- bun test test-integration"
  },
  "dependencies": {
    "@iam/contracts": "workspace:*",
    "bcrypt-ts": "^9.0.2",
    "ioredis": "^6.0.0",
    "pino": "^10.3.1",
    "pino-pretty": "^13.1.3",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "@typescript/native": "npm:typescript@7.0.2",
    "typescript": "npm:@typescript/typescript6@6.0.2"
  },
  "iamTest": {
    "integration": {
      "bun": {
        "redis": "IAM_RUNTIME_TEST_REDIS_URL"
      }
    }
  }
}
