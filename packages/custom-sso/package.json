{
  "name": "@iam/custom-sso",
  "type": "module",
  "version": "0.0.1",
  "private": true,
  "exports": {
    ".": "./src/index.ts",
    "./wire": "./src/wire.ts",
    "./maintenance": "./src/maintenance.ts",
    "./testing": "./src/testing.ts"
  },
  "scripts": {
    "lint": "node ../../scripts/run-quality.mjs lint --workspace packages/custom-sso",
    "lint:fix": "node ../../scripts/run-quality.mjs lint-fix --workspace packages/custom-sso",
    "test": "pnpm test:unit",
    "test:unit": "bun test --max-concurrency=2 src",
    "typecheck": "pnpm exec tsc --noEmit",
    "format": "node ../../scripts/run-quality.mjs format --workspace packages/custom-sso",
    "format:check": "node ../../scripts/run-quality.mjs format-check --workspace packages/custom-sso"
  },
  "dependencies": {
    "@iam/api-core": "workspace:*",
    "@iam/client-subject-projection": "workspace:*",
    "@iam/contracts": "workspace:*",
    "@iam/domain": "workspace:*",
    "@iam/session-kernel": "workspace:*",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "@typescript/native": "npm:typescript@7.0.2",
    "ioredis": "^6.0.0",
    "typescript": "npm:@typescript/typescript6@6.0.2"
  }
}
