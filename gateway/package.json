{
  "name": "@iam/gateway-apisix",
  "type": "module",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "apisix": "bun src/cli.ts",
    "validate": "bun src/cli.ts validate",
    "diff": "bun src/cli.ts diff",
    "apply": "bun src/cli.ts apply",
    "lint": "node ../scripts/run-quality.mjs lint --workspace gateway",
    "lint:fix": "node ../scripts/run-quality.mjs lint-fix --workspace gateway",
    "test": "pnpm test:unit",
    "test:unit": "bun test --max-concurrency=2 src",
    "test:integration:component": "bun test --max-concurrency=2 test-integration/component",
    "typecheck": "pnpm exec tsc --noEmit",
    "format": "node ../scripts/run-quality.mjs format --workspace gateway",
    "format:check": "node ../scripts/run-quality.mjs format-check --workspace gateway"
  },
  "dependencies": {
    "commander": "^15.0.0",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "@typescript/native": "npm:typescript@7.0.2",
    "typescript": "npm:@typescript/typescript6@6.0.2"
  }
}
