    "yaml": "^2.8.2"
  },
  "devDependencies": {
    "@antfu/eslint-config": "^9.1.0",
    "@types/bun": "latest",
    "@typescript/native": "npm:typescript@7.0.2",
    "eslint": "^10.7.0",
    "eslint-plugin-format": "^2.0.1",
    "typescript": "npm:@typescript/typescript6@6.0.2"
  }
}
