# Gateway APISIX sync CLI environment example.
# Copy to gateway/.env for local development.

# Manifest scope. Commands can still override this with --env <env:app>.
APISIX_MANIFEST_ENV=dev:iam

# Local APISIX Admin API from docker/docker-compose-dev.yml.
APISIX_ADMIN_URL=http://127.0.0.1:9180/apisix/admin

# Keep this aligned with gateway/config/config.dev.yaml.
APISIX_ADMIN_KEY=dev-local-admin-key-change-me
APISIX_OTEL_COLLECTOR_ENDPOINT=alloy:4318

# Dev SSO routes match the request Host header, including the published port.
# Pair these with IAM_API_SSO_EXTERNAL_ORIGIN=http://iam-sso.localhost:30080 and
# IAM_API_SSO_INTERNAL_ORIGIN=http://iam-sso.internal.localhost:30080 in docker/.env.
# The docker/.env.dev.example origin defaults do not match these gateway hosts.
# Align browser SSO and OIDC client URLs with the same authorities.
# Override both gateway hosts and API origins for another dev gateway.
IAM_SSO_EXTERNAL_HOST=iam-sso.localhost:30080
IAM_SSO_INTERNAL_HOST=iam-sso.internal.localhost:30080

# Upstream nodes. Manifest files render these only when commands use
# --env-file .env or --render-env.
DEV_IAM_API_UPSTREAM_HOST=api
DEV_IAM_API_UPSTREAM_PORT=30000
DEV_IAM_ADMIN_API_UPSTREAM_HOST=admin-api
DEV_IAM_ADMIN_API_UPSTREAM_PORT=30001
DEV_IAM_SSO_FRONTEND_UPSTREAM_HOST=sso
DEV_IAM_SSO_FRONTEND_UPSTREAM_PORT=80
DEV_IAM_ADMIN_FRONTEND_UPSTREAM_HOST=admin
DEV_IAM_ADMIN_FRONTEND_UPSTREAM_PORT=80

DEV_TENDER_FRONTEND_UPSTREAM_HOST=176.169.99.150
DEV_TENDER_FRONTEND_UPSTREAM_PORT=80
DEV_TENDER_API_UPSTREAM_HOST=176.169.99.150
DEV_TENDER_API_UPSTREAM_PORT=18091

DEV_GDS_FRONTEND_UPSTREAM_HOST=176.169.99.124
DEV_GDS_FRONTEND_UPSTREAM_PORT=18080
DEV_GDS_API_UPSTREAM_HOST=176.169.99.124
DEV_GDS_API_UPSTREAM_PORT=17011
DEV_GDS_AIQC_API_UPSTREAM_HOST=176.169.99.124
DEV_GDS_AIQC_API_UPSTREAM_PORT=17012
DEV_GDS_DASHBOARD_UPSTREAM_HOST=176.169.99.109
DEV_GDS_DASHBOARD_UPSTREAM_PORT=8080
# The forward-auth URL is called from inside the APISIX container.
DEV_GDS_AUTHZ_API_URL=http://apisix:9080/api/iam/auth/authz

# Subapp ports must be reachable from APISIX and restricted to trusted gateway access.
DEV_GDS_SUBAPP_AI_QC_API_UPSTREAM_HOST=176.169.99.124
DEV_GDS_SUBAPP_AI_QC_API_UPSTREAM_PORT=4311
DEV_GDS_SUBAPP_AI_QC_WEB_UPSTREAM_HOST=176.169.99.124
DEV_GDS_SUBAPP_AI_QC_WEB_UPSTREAM_PORT=4411
DEV_GDS_SUBAPP_HR_API_UPSTREAM_HOST=176.169.99.124
DEV_GDS_SUBAPP_HR_API_UPSTREAM_PORT=4312
DEV_GDS_SUBAPP_HR_WEB_UPSTREAM_HOST=176.169.99.124
DEV_GDS_SUBAPP_HR_WEB_UPSTREAM_PORT=4412
DEV_GDS_SUBAPP_GAS_API_UPSTREAM_HOST=176.169.99.124
DEV_GDS_SUBAPP_GAS_API_UPSTREAM_PORT=4313
DEV_GDS_SUBAPP_GAS_WEB_UPSTREAM_HOST=176.169.99.124
DEV_GDS_SUBAPP_GAS_WEB_UPSTREAM_PORT=4413

PROD_IAM_API_UPSTREAM_HOST=176.169.89.71
PROD_IAM_API_UPSTREAM_PORT=30000
PROD_IAM_ADMIN_API_UPSTREAM_HOST=176.169.89.71
PROD_IAM_ADMIN_API_UPSTREAM_PORT=30001
PROD_IAM_SSO_FRONTEND_UPSTREAM_HOST=176.169.89.71
PROD_IAM_SSO_FRONTEND_UPSTREAM_PORT=30013
PROD_IAM_ADMIN_FRONTEND_UPSTREAM_HOST=176.169.89.71
PROD_IAM_ADMIN_FRONTEND_UPSTREAM_PORT=30014

PROD_TENDER_FRONTEND_UPSTREAM_HOST=176.169.99.125
PROD_TENDER_FRONTEND_UPSTREAM_PORT=80
PROD_TENDER_FRONTEND_EXTERNAL_UPSTREAM_HOST=176.169.99.125
PROD_TENDER_FRONTEND_EXTERNAL_UPSTREAM_PORT=81
PROD_TENDER_API_UPSTREAM_HOST=176.169.99.125
PROD_TENDER_API_UPSTREAM_PORT=18091
PROD_TENDER_MINIO_UPSTREAM_HOST=176.169.99.125
PROD_TENDER_MINIO_UPSTREAM_PORT=9000

PROD_GDS_FRONTEND_UPSTREAM_HOST=176.169.99.125
PROD_GDS_FRONTEND_UPSTREAM_PORT=80
PROD_GDS_EXTERNAL_FRONTEND_UPSTREAM_HOST=176.169.99.125
