# Gateway APISIX sync CLI environment example.
# Copy to gateway/.env for local development.

# Manifest scope. Commands can still override this with --env <env:app>.
APISIX_MANIFEST_ENV=dev:iam

# Local APISIX Admin API from docker/docker-compose-dev.yml.
APISIX_ADMIN_URL=http://127.0.0.1:9180/apisix/admin

# Keep this aligned with gateway/config/config.dev.yaml.
APISIX_ADMIN_KEY=dev-local-admin-key-change-me
