# Docker production compose environment example.
# Copy to docker/.env.prod or docker/.env on each production host, then replace
# every change-me value with a real secret or reachable production endpoint.
# Never commit real production secrets.
# BREAKING rename: app runtime env now uses IAM_<APP>_* and frontend build env uses UMI_APP_<APP>_*.

# Build/runtime proxy. Leave empty when the host does not require a proxy.
HTTP_PROXY=
HTTPS_PROXY=
NO_PROXY=localhost,127.0.0.1,::1,postgres-primary,redis,apisix,apisix-etcd,*.internal
http_proxy=
https_proxy=
no_proxy=localhost,127.0.0.1,::1,postgres-primary,redis,apisix,apisix-etcd,*.internal

# Image overrides.
POSTGRES_IMAGE=docker.xuanyuan.run/postgres:18
REDIS_IMAGE=docker.xuanyuan.run/library/redis:latest
IAM_API_IMAGE=iam-api:latest
IAM_ADMIN_API_IMAGE=iam-admin-api:latest
IAM_OIDC_PROVIDER_IMAGE=iam-oidc-provider:latest
IAM_SSO_IMAGE=iam-sso:latest
IAM_ADMIN_IMAGE=iam-admin:latest
APISIX_ETCD_IMAGE=docker.xuanyuan.run/bitnamilegacy/etcd:3.5.11
APISIX_IMAGE=docker.xuanyuan.run/apache/apisix:3.16.0-debian
LOKI_IMAGE=grafana/loki:3.5.1
GRAFANA_IMAGE=grafana/grafana-oss:12.0.2
GRAFANA_ALLOY_IMAGE=grafana/alloy:v1.9.2

# Published host ports. Replica ports may duplicate primary when services run
# on separate hosts; use unique values only when colocating them on one host.
POSTGRES_PRIMARY_PUBLISHED_PORT=5432
POSTGRES_REPLICA_1_PUBLISHED_PORT=5432
POSTGRES_REPLICA_2_PUBLISHED_PORT=5432
REDIS_PUBLISHED_PORT=6379
IAM_API_PUBLISHED_PORT=30000
IAM_ADMIN_API_PUBLISHED_PORT=30001
IAM_OIDC_PROVIDER_PUBLISHED_PORT=30002
IAM_SSO_PUBLISHED_PORT=30013
IAM_ADMIN_PUBLISHED_PORT=30014
APISIX_ETCD_PUBLISHED_PORT=2379
APISIX_HTTP_PUBLISHED_PORT=9080
APISIX_HTTPS_PUBLISHED_PORT=9443
APISIX_ADMIN_PUBLISHED_HOST=127.0.0.1
APISIX_ADMIN_PUBLISHED_PORT=9180
LOKI_HTTP_PUBLISHED_HOST=127.0.0.1
LOKI_HTTP_PUBLISHED_PORT=3100
GRAFANA_HTTP_PUBLISHED_PORT=3000
ALLOY_HTTP_PUBLISHED_HOST=127.0.0.1
ALLOY_HTTP_PUBLISHED_PORT=12345

# Persistent data paths.
POSTGRES_PRIMARY_DATA_PATH=/data/postgres-primary
POSTGRES_REPLICA_1_DATA_PATH=/data/postgres-replica-1
POSTGRES_REPLICA_2_DATA_PATH=/data/postgres-replica-2
REDIS_DATA_PATH=/data/redis
APISIX_ETCD_DATA_PATH=/data/apisix-etcd
LOKI_DATA_PATH=/data/loki
GRAFANA_DATA_PATH=/data/grafana
ALLOY_DATA_PATH=/data/alloy
APISIX_CONFIG_PATH=../gateway/config/config.prod.example.yaml

# PostgreSQL.
POSTGRES_USER=iam
POSTGRES_PASSWORD=change-me-postgres-password
POSTGRES_DB=iam_db
POSTGRES_PRIMARY_HOST=postgres-primary
POSTGRES_PRIMARY_PORT=5432
POSTGRES_REPLICATION_USER=iam_replicator
POSTGRES_REPLICATION_PASSWORD=change-me-postgres-replication-password
POSTGRES_REPLICATION_CIDR=10.0.0.0/8
POSTGRES_REPLICA_1_SLOT=iam_replica_1
POSTGRES_REPLICA_2_SLOT=iam_replica_2

# Redis container.
REDIS_PASSWORD=change-me-redis-password

# Shared backend runtime.
IAM_LOG_ENV=prod
IAM_LOG_LEVEL=info
IAM_LOG_FORMAT=json
IAM_REDIS_HOST=redis
IAM_REDIS_PORT=6379
IAM_REDIS_PASSWORD=change-me-redis-password
IAM_REDIS_DB=0
IAM_SESSION_KERNEL_NAMESPACE=sess:v2:
IAM_SESSION_KERNEL_PRINCIPAL_IDLE_TTL_SECONDS=86400
IAM_SESSION_KERNEL_PRINCIPAL_ABSOLUTE_TTL_SECONDS=86400
IAM_SESSION_KERNEL_TOMBSTONE_TTL_SECONDS=86400
IAM_SESSION_KERNEL_TOMBSTONE_GRACE_SECONDS=300
IAM_SESSION_LOOKUP_HMAC_CURRENT_ID=prod-current
IAM_SESSION_LOOKUP_HMAC_CURRENT_SECRET=change-me-session-lookup-hmac-secret
IAM_SESSION_LOOKUP_HMAC_PREVIOUS_ID=
IAM_SESSION_LOOKUP_HMAC_PREVIOUS_SECRET=

# API service. Leave IAM_API_DATABASE_URL empty to derive it from PostgreSQL values above.
IAM_API_DATABASE_URL=
IAM_API_PASSWORD_HASH_ROUNDS=10
IAM_API_MAGIC_CODE=change-me-production-magic-code
IAM_API_CAP_ENABLED=true
IAM_API_CAP_SITE_KEY=iam-sso
IAM_API_CAP_SECRET=change-me-cap-secret
IAM_API_CAP_CHALLENGE_TTL_MS=600000
IAM_API_CAP_TOKEN_TTL_SECONDS=600
IAM_API_HUMAN_VERIFICATION_WINDOW_SECONDS=600
IAM_API_HUMAN_VERIFICATION_LOGIN_FAILURE_THRESHOLD=3
IAM_API_HUMAN_VERIFICATION_LOOKUP_THRESHOLD=20
IAM_API_LOGIN_CREDENTIAL_ACTIVE_KID=2026-05-primary
IAM_API_LOGIN_CREDENTIAL_PRIVATE_KEYS_JSON={"2026-05-primary":"replace-with-64-hex-private-key"}
IAM_API_LOGIN_CREDENTIAL_MAX_SKEW_MS=300000
IAM_API_LOGIN_CREDENTIAL_NONCE_TTL_SECONDS=360
IAM_API_WECHAT_CORP_ID=change-me-wechat-corp-id
IAM_API_WECHAT_CORP_SECRET=change-me-wechat-corp-secret
IAM_API_SMS_URL=https://sms.example.com/api/send
IAM_API_SMS_SIGNATURE_KEY=change-me-sms-signature-key
IAM_API_ORCAS_URL=https://orcas.example.com/orcas/login
IAM_API_SESSION_DEFAULT_TTL_SECONDS=86400
IAM_API_AUTH_CODE_TTL_SECONDS=300
IAM_API_LOGIN_ENDPOINT=/portal/login
IAM_API_SSO_INTERNAL_ORIGIN=https://iam.internal.example.com
IAM_API_SSO_EXTERNAL_ORIGIN=https://iam.example.com
IAM_API_AUTHORIZATION_ENDPOINT=/sso/authorize
IAM_API_LOGOUT_ENDPOINT=/sso/logout
IAM_API_THIRDPARTY_OA_ENDPOINT=/sso/thirdparty/oa

# Admin API service. Leave IAM_ADMIN_API_DATABASE_URL empty to derive it from PostgreSQL values above.
IAM_ADMIN_API_DATABASE_URL=
IAM_ADMIN_API_PASSWORD_HASH_ROUNDS=10
IAM_ADMIN_API_ADMIN_CLIENT_CODES=iam-admin
IAM_ADMIN_API_ADMIN_ROLE_CODES=iam:admin

# OIDC provider service. Leave IAM_OIDC_PROVIDER_DATABASE_URL empty to derive it from PostgreSQL values above.
# Replace IAM_OIDC_PROVIDER_CURRENT_JWK_JSON with a complete private signing JWK and keep previous during rotation only.
IAM_OIDC_PROVIDER_DATABASE_URL=
IAM_OIDC_PROVIDER_ISSUER=https://iam.example.com/oidc
IAM_OIDC_PROVIDER_PUBLIC_ORIGIN=https://iam.example.com
IAM_OIDC_PROVIDER_SSO_LOGIN_PATH=/portal/login
IAM_OIDC_PROVIDER_COOKIE_KEYS=change-me-cookie-key-primary,change-me-cookie-key-secondary
IAM_OIDC_PROVIDER_CURRENT_JWK_JSON={"kty":"RSA","kid":"prod-rs256","use":"sig","alg":"RS256","n":"replace-with-rsa-modulus","e":"AQAB","d":"replace-with-rsa-private-exponent"}
IAM_OIDC_PROVIDER_PREVIOUS_JWK_JSON=
IAM_OIDC_PROVIDER_GLOBAL_SESSION_COOKIE=global_session
IAM_OIDC_PROVIDER_GLOBAL_SESSION_TTL_SECONDS=86400
IAM_OIDC_PROVIDER_AUTHORIZATION_CODE_TTL_SECONDS=300
IAM_OIDC_PROVIDER_INTERACTION_TTL_SECONDS=600
IAM_OIDC_PROVIDER_ACCESS_TOKEN_TTL_SECONDS=3600
IAM_OIDC_PROVIDER_ID_TOKEN_TTL_SECONDS=3600
IAM_OIDC_PROVIDER_CLIENT_CACHE_TTL_SECONDS=60
IAM_OIDC_PROVIDER_BCRYPT_COST=12
IAM_OIDC_PROVIDER_CLIENT_AUTH_FAILURE_LIMIT=5
IAM_OIDC_PROVIDER_CLIENT_AUTH_FAILURE_WINDOW_SECONDS=60
IAM_OIDC_PROVIDER_TRUST_PROXY=true

# SSO frontend build args.
UMI_APP_SSO_API_PREFIX=/api/iam
UMI_APP_SSO_CLIENT_CODE=iam
UMI_APP_SSO_CAP_SITE_KEY=iam-sso
UMI_APP_SSO_CAP_ENDPOINT=/api/iam/open/cap/iam-sso/
UMI_APP_SSO_CAP_WASM_URL=/portal/cap/cap_wasm_bg.wasm
UMI_APP_SSO_CAP_PAKO_URL=/portal/cap/pako_inflate.min.js
UMI_APP_SSO_LOGIN_CREDENTIAL_KID=2026-05-primary
UMI_APP_SSO_LOGIN_CREDENTIAL_PUBLIC_KEY=replace-with-uncompressed-public-key-hex
UMI_APP_SSO_WELL_KNOWN_URL=/sso/.well-known/authentication-configuration

# Admin frontend build args.
UMI_APP_ADMIN_API_PREFIX=/api/iam
UMI_APP_ADMIN_SSO_AUTHORIZE_URL=/sso/authorize
UMI_APP_ADMIN_SSO_LOGOUT_URL=/sso/logout
UMI_APP_ADMIN_CLIENT_CODE=iam-admin
UMI_APP_ADMIN_ROLE_CODE=iam:admin
UMI_APP_ADMIN_GRAFANA_URL=https://grafana.example.com
UMI_APP_ADMIN_SYSTEM_LOG_ENV=prod

# APISIX gateway compose and sync CLI.
APISIX_ETCD_ALLOW_NONE_AUTHENTICATION=no
APISIX_ETCD_ROOT_PASSWORD=change-me-apisix-etcd-root-password
APISIX_ETCD_ADVERTISE_CLIENT_URLS=http://apisix-etcd:2379
APISIX_ETCD_LISTEN_CLIENT_URLS=http://0.0.0.0:2379
APISIX_ADMIN_KEY=change-me-apisix-admin-key
APISIX_ADMIN_ALLOW_CIDR=10.0.0.0/8
APISIX_ETCD_ENDPOINT=http://apisix-etcd:2379
APISIX_ETCD_USER=root
APISIX_ETCD_PASSWORD=
APISIX_MANIFEST_ENV=prod:iam
APISIX_ADMIN_URL=http://127.0.0.1:9180/apisix/admin
TENCENT_NGINX_TRUSTED_CIDR=10.0.0.0/24
IAM_SSO_EXTERNAL_HOST=iam.example.com
IAM_SSO_INTERNAL_HOST=iam.internal.example.com
IAM_SSO_CORS_ALLOW_ORIGINS=https://iam.example.com
PROD_IAM_API_UPSTREAM_HOST=api.internal.example.com
PROD_IAM_API_UPSTREAM_PORT=30000
PROD_IAM_ADMIN_API_UPSTREAM_HOST=admin-api.internal.example.com
PROD_IAM_ADMIN_API_UPSTREAM_PORT=30001
PROD_IAM_OIDC_PROVIDER_UPSTREAM_HOST=oidc.internal.example.com
PROD_IAM_OIDC_PROVIDER_UPSTREAM_PORT=30002
PROD_IAM_SSO_FRONTEND_UPSTREAM_HOST=sso.internal.example.com
PROD_IAM_SSO_FRONTEND_UPSTREAM_PORT=30013
PROD_IAM_ADMIN_FRONTEND_UPSTREAM_HOST=admin.internal.example.com
PROD_IAM_ADMIN_FRONTEND_UPSTREAM_PORT=30014

# Observability profile.
ALLOY_LOG_LEVEL=info
IAM_LOG_HOST=prod-host-01
LOKI_PUSH_URL=http://loki:3100/loki/api/v1/push
GRAFANA_ROOT_URL=https://grafana.example.com
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=change-me-grafana-admin-password
GRAFANA_AUTH_DISABLE_LOGIN_FORM=false
GRAFANA_OIDC_ENABLED=true
GRAFANA_OIDC_NAME=IAM
GRAFANA_OIDC_CLIENT_ID=grafana
GRAFANA_OIDC_CLIENT_SECRET=change-me-grafana-oidc-client-secret
GRAFANA_OIDC_SCOPES=openid profile
GRAFANA_OIDC_AUTH_URL=https://iam.example.com/oidc/auth
GRAFANA_OIDC_TOKEN_URL=https://iam.example.com/oidc/token
GRAFANA_OIDC_USERINFO_URL=https://iam.example.com/oidc/me
GRAFANA_OIDC_LOGIN_ATTRIBUTE_PATH=preferred_username
GRAFANA_OIDC_NAME_ATTRIBUTE_PATH=name
GRAFANA_OIDC_EMAIL_ATTRIBUTE_PATH=preferred_username
GRAFANA_OIDC_SIGNOUT_REDIRECT_URL=
GRAFANA_LOKI_URL=http://loki:3100
GRAFANA_DEV_ALERT_WEBHOOK_URL=http://127.0.0.1:9/iam-prod-null
