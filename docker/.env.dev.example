OIDC_CLIENT_AUTH_FAILURE_WINDOW_SECONDS=60
OIDC_TRUST_PROXY=true

# Observability profile.
ALLOY_LOG_LEVEL=info
IAM_LOG_HOST=dev-docker
LOKI_PUSH_URL=http://loki:3100/loki/api/v1/push
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin
GRAFANA_AUTH_ANONYMOUS_ENABLED=true
GRAFANA_AUTH_ANONYMOUS_ORG_ROLE=Admin
GRAFANA_ROOT_URL=http://localhost:30030
GRAFANA_LOKI_URL=http://loki:3100
GRAFANA_DEV_ALERT_WEBHOOK_URL=http://127.0.0.1:9/iam-dev-null

# Grafana OIDC login. Set GRAFANA_OIDC_ENABLED=true and disable anonymous login to test it.
GRAFANA_OIDC_ENABLED=false
GRAFANA_AUTH_DISABLE_LOGIN_FORM=false
GRAFANA_OIDC_NAME=IAM
GRAFANA_OIDC_ALLOW_SIGN_UP=true
GRAFANA_OIDC_CLIENT_ID=grafana
GRAFANA_OIDC_CLIENT_SECRET=
GRAFANA_OIDC_SCOPES=openid profile
GRAFANA_OIDC_AUTH_URL=http://localhost:30080/oidc/auth
GRAFANA_OIDC_TOKEN_URL=http://host.docker.internal:30080/oidc/token
GRAFANA_OIDC_USERINFO_URL=http://host.docker.internal:30080/oidc/me
GRAFANA_OIDC_USE_PKCE=true
GRAFANA_OIDC_LOGIN_ATTRIBUTE_PATH=preferred_username
GRAFANA_OIDC_NAME_ATTRIBUTE_PATH=name
GRAFANA_OIDC_EMAIL_ATTRIBUTE_PATH=preferred_username
GRAFANA_USERS_ALLOW_SIGN_UP=true
GRAFANA_AUTO_ASSIGN_ORG_ROLE=Admin
