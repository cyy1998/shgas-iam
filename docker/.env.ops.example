# Copy to docker/.env.ops. Select the exact release used by the target applications.
IAM_OPS_IMAGE=iam-ops:1.0.0
# Only set resources needed by the selected command; help needs neither connection.
# Same Docker daemon: existing iam-service-prod default network service names are usable.
# A separate host needs actual reachable addresses; the project name is not a cross-host network.
IAM_OPS_DATABASE_URL=
# 仅本次命令需要 Redis 时填写，如 redis://:password@redis:6379/0。
IAM_OPS_REDIS_URL=
# IAM_OPS_LOG_LEVEL=info
# IAM_OPS_LOG_FORMAT=json
# IAM_OPS_USER_DOCUMENT_REBUILD_BATCH_SIZE=100
# IAM_OPS_USER_DOCUMENT_BACKFILL_BATCH_SIZE=500
# IAM_OPS_USER_DOCUMENT_REPAIR_STALE_SECONDS=300
# IAM_OPS_ORGANIZATION_DOCUMENT_BACKFILL_BATCH_SIZE=500
# IAM_OPS_ORGANIZATION_DOCUMENT_REPAIR_STALE_SECONDS=300

# 上述注释项使用 Compose 默认值；按本次命令需要覆盖。
