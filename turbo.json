{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**"]
    },
    "dev": {
      "dependsOn": ["^build"],
      "persistent": true,
      "cache": false
    },
    "transit": {
      "dependsOn": ["^transit"]
    },
    "test:unit": {
      "dependsOn": ["transit"]
    },
    "//#test:unit:root": {},
    "//#typecheck:root": {
      "inputs": [
        "$TURBO_ROOT$/scripts/sandcastle/**",
        "$TURBO_ROOT$/scripts/__tests__/sandcastle*.test.ts",
        "$TURBO_ROOT$/package.json",
        "$TURBO_ROOT$/pnpm-lock.yaml"
      ]
    },
    "test:integration:component": {
      "dependsOn": ["transit"]
    },
    "test:integration:browser": {
      "dependsOn": ["transit"],
      "cache": false,
      "passThroughEnv": ["IAM_API_TEST_REDIS_URL"]
    },
    "test:integration:process": {
      "dependsOn": ["transit"],
      "cache": false
    },
    "//#test:integration:process:root": {
      "cache": false
    },
    "test:integration:postgres": {
      "dependsOn": ["transit"],
      "cache": false,
      "passThroughEnv": [
        "IAM_ADMIN_API_TEST_DATABASE_URL",
        "IAM_API_TEST_DATABASE_URL",
        "IAM_DB_TEST_DATABASE_URL",
        "IAM_ORGANIZATION_RESPONSIBILITY_TEST_DATABASE_URL",
        "IAM_ROLE_ASSIGNMENT_TEST_DATABASE_URL",
        "IAM_USER_PROFILE_TEST_DATABASE_URL",
        "IAM_WORKER_TEST_DATABASE_URL"
      ]
    },
    "test:integration:composition": {
      "dependsOn": ["transit"],
      "cache": false,
      "passThroughEnv": [
        "IAM_ADMIN_API_TEST_DATABASE_URL",
        "IAM_ADMIN_API_TEST_REDIS_URL",
        "IAM_API_CORE_TEST_REDIS_URL",
        "IAM_API_TEST_DATABASE_URL",
        "IAM_API_TEST_REDIS_URL",
        "IAM_USER_PROFILE_TEST_REDIS_URL",
        "IAM_WORKER_TEST_DATABASE_URL",
        "IAM_WORKER_TEST_REDIS_URL"
      ]
    },
    "test:integration:redis": {
      "dependsOn": ["transit"],
      "cache": false,
      "passThroughEnv": [
        "IAM_ADMIN_API_TEST_REDIS_URL",
        "IAM_API_CORE_TEST_REDIS_URL",
        "IAM_SESSION_KERNEL_TEST_REDIS_URL",
        "IAM_OIDC_TEST_REDIS_URL",
        "IAM_API_TEST_REDIS_URL",
        "IAM_USER_PROFILE_TEST_REDIS_URL",
        "IAM_WORKER_TEST_REDIS_URL"
      ]
    },
    "test:e2e": {
      "dependsOn": ["transit"],
      "cache": false
    },
    "test:coverage": {
      "dependsOn": ["transit"],
      "outputs": ["coverage/**"]
    },
    "typecheck": {
      "dependsOn": ["^typecheck"]
    }
  }
}
