{
  "$schema": "https://turbo.build/schema.json",
  "globalPassThroughEnv": ["IAM_OWNED_PROCESS_MARKERS"],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**"]
    },
    "dev": {
      "dependsOn": ["^build"],
      "persistent": true,
      "cache": false
    },
    "transit": {
      "dependsOn": ["^transit"]
    },
    "test:unit": {
      "dependsOn": ["transit"]
    },
    "//#typecheck:root": {
      "inputs": [
        "$TURBO_ROOT$/scripts/**",
        "$TURBO_ROOT$/.sandcastle/*.ts",
        "$TURBO_ROOT$/.sandcastle/*.mts",
        "$TURBO_ROOT$/.sandcastle/__tests__/**",
        "$TURBO_ROOT$/package.json",
        "$TURBO_ROOT$/pnpm-lock.yaml",
        "$TURBO_ROOT$/packages/runtime/package.json",
        "$TURBO_ROOT$/packages/runtime/src/**"
      ]
    },
    "test:coverage": {
      "dependsOn": ["transit"],
      "outputs": ["coverage/**"]
    },
    "typecheck": {
      "dependsOn": ["^typecheck"]
    },
    "test:integration:bun": {
      "dependsOn": ["transit"],
      "cache": false,
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/scripts/run-package-integration.mjs",
        "$TURBO_ROOT$/scripts/test-resources/**"
      ],
      "passThroughEnv": [
        "IAM_*_TEST_DATABASE_URL",
        "IAM_*_TEST_REDIS_URL",
        "IAM_TEST_RESOURCE_RUN_ID",
        "IAM_TEST_RESOURCE_RECORD",
        "IAM_TEST_INTEGRATION_SELECTION",
        "IAM_TEST_RESOURCE_REGISTRY",
        "PLAYWRIGHT_BROWSERS_PATH"
      ]
    },
    "test:integration:vitest": {
      "dependsOn": ["transit"],
      "cache": false,
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/scripts/run-package-integration.mjs",
        "$TURBO_ROOT$/scripts/test-resources/**"
      ],
      "passThroughEnv": [
        "IAM_*_TEST_DATABASE_URL",
        "IAM_*_TEST_REDIS_URL",
        "IAM_TEST_RESOURCE_RUN_ID",
        "IAM_TEST_RESOURCE_RECORD",
        "IAM_TEST_INTEGRATION_SELECTION",
        "IAM_TEST_RESOURCE_REGISTRY",
        "PLAYWRIGHT_BROWSERS_PATH"
      ]
    },
    "test:integration:playwright": {
      "dependsOn": ["transit"],
      "cache": false,
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/scripts/run-package-integration.mjs",
        "$TURBO_ROOT$/scripts/test-resources/**"
      ],
      "passThroughEnv": [
        "IAM_*_TEST_DATABASE_URL",
        "IAM_*_TEST_REDIS_URL",
        "IAM_TEST_RESOURCE_RUN_ID",
        "IAM_TEST_RESOURCE_RECORD",
        "IAM_TEST_INTEGRATION_SELECTION",
        "IAM_TEST_RESOURCE_REGISTRY",
        "IAM_TEST_BROWSER_WORKERS",
        "IAM_PW_DEV_SERVER",
        "IAM_ADMIN_WEB_*",
        "IAM_SSO_WEB_*",
        "PLAYWRIGHT_BROWSERS_PATH"
      ]
    }
  }
}
