{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**"]
    },
    "dev": {
      "dependsOn": ["^build"],
      "persistent": true,
      "cache": false
    },
    "lint": {
      "dependsOn": ["^lint"]
    },
    "//#lint:root": {
      "inputs": [
        "$TURBO_ROOT$/scripts/**",
        "$TURBO_ROOT$/eslint.root.config.mjs",
        "$TURBO_ROOT$/eslint.frontend.config.mjs",
        "$TURBO_ROOT$/stylelint.frontend.config.mjs",
        "$TURBO_ROOT$/package.json",
        "$TURBO_ROOT$/pnpm-lock.yaml",
        "$TURBO_ROOT$/.scratch/*/delivery.md",
        "$TURBO_ROOT$/.scratch/*/spec.md",
        "$TURBO_ROOT$/.scratch/*/issues/*.md",
        "$TURBO_ROOT$/packages/eslint-config/package.json",
        "$TURBO_ROOT$/packages/eslint-config/src/**"
      ]
    },
    "lint:fix": {
      "dependsOn": ["^lint:fix"],
      "cache": false
    },
    "//#lint:fix:root": {
      "cache": false
    },
    "test": {
      "dependsOn": ["^test"]
    },
    "e2e": {
      "cache": false
    },
    "typecheck": {
      "dependsOn": ["^typecheck"]
    }
  }
}
