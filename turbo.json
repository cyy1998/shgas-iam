{
  "$schema": "https://turbo.build/schema.json",
  "globalPassThroughEnv": ["IAM_OWNED_PROCESS_MARKERS"],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**"]
    },
    "build:test": {
      "dependsOn": ["^build"],
      "outputs": ["dist-test/**"],
      "env": ["IAM_ADMIN_WEB_*", "IAM_SSO_WEB_*"]
    },
    "dev": {
      "dependsOn": ["^build"],
      "persistent": true,
      "cache": false
    },
    "transit": {
      "dependsOn": ["^transit"]
    },
    "test:unit": {
      "dependsOn": ["transit"]
    },
    "//#typecheck:root": {
      "inputs": [
        "$TURBO_ROOT$/scripts/**",
        "$TURBO_ROOT$/.sandcastle/*.ts",
        "$TURBO_ROOT$/.sandcastle/*.mts",
        "$TURBO_ROOT$/.sandcastle/tsconfig.json",
        "$TURBO_ROOT$/.sandcastle/__tests__/**",
        "$TURBO_ROOT$/package.json",
        "$TURBO_ROOT$/pnpm-lock.yaml",
        "$TURBO_ROOT$/packages/runtime/package.json",
        "$TURBO_ROOT$/packages/runtime/src/**"
      ]
    },
    "test:coverage": {
      "dependsOn": ["transit"],
      "outputs": ["coverage/**"]
    },
    "typecheck": {
      "dependsOn": ["^typecheck"]
    }
  }
}
