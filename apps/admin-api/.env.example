# ================================
# IAM Admin API 环境变量配置示例
# ================================

# 数据库配置
IAM_ADMIN_API_DATABASE_URL=postgresql://iam:iam_password@localhost:5432/iam_db

# Redis 配置
IAM_ADMIN_API_REDIS_HOST=localhost
IAM_ADMIN_API_REDIS_PORT=6379
IAM_ADMIN_API_REDIS_PASSWORD=
IAM_ADMIN_API_REDIS_DB=0

# 服务器配置
IAM_ADMIN_API_PORT=30001
NODE_ENV=development
IAM_ADMIN_API_LOG_LEVEL=info
IAM_ADMIN_API_LOG_FORMAT=auto

# 用户密码配置
IAM_ADMIN_API_PASSWORD_HASH_ROUNDS=10

# 管理端鉴权配置
IAM_ADMIN_API_ADMIN_CLIENT_CODES=iam-admin
IAM_ADMIN_API_ADMIN_ROLE_CODES=iam:admin

# Session Kernel 配置（必须与 API 使用同一 namespace 和 HMAC key）
IAM_ADMIN_API_SESSION_KERNEL_NAMESPACE=sess:v2:
IAM_ADMIN_API_SESSION_KERNEL_PRINCIPAL_IDLE_TTL_SECONDS=86400
IAM_ADMIN_API_SESSION_KERNEL_PRINCIPAL_ABSOLUTE_TTL_SECONDS=86400
IAM_ADMIN_API_SESSION_KERNEL_TOMBSTONE_TTL_SECONDS=86400
IAM_ADMIN_API_SESSION_KERNEL_TOMBSTONE_GRACE_SECONDS=300
IAM_ADMIN_API_SESSION_LOOKUP_HMAC_CURRENT_ID=dev-current
IAM_ADMIN_API_SESSION_LOOKUP_HMAC_CURRENT_SECRET=dev-session-lookup-hmac-secret-32-bytes
IAM_ADMIN_API_SESSION_LOOKUP_HMAC_PREVIOUS_ID=
IAM_ADMIN_API_SESSION_LOOKUP_HMAC_PREVIOUS_SECRET=
