{
  "name": "@iam/admin-api",
  "type": "module",
  "version": "1.0.0",
  "private": true,
  "exports": {
    ".": "./src/app.ts",
    "./trpc": "./src/trpc/trpc.router.ts"
  },
  "module": "index.ts",
  "devEngines": {
    "runtime": {
      "name": "bun",
      "version": "1.3.14"
    }
  },
  "scripts": {
    "dev": "bun --hot src/index.ts",
    "serve": "bun run src/index.ts",
    "lint": "eslint src eslint.config.js",
    "lint:fix": "eslint --fix src eslint.config.js",
    "test": "bun test --parallel",
    "typecheck": "pnpm exec tsgo --noEmit"
  },
  "dependencies": {
    "@hono/zod-openapi": "^1.4.0",
    "@iam/api-core": "workspace:*",
    "@iam/contracts": "workspace:*",
    "@iam/db": "workspace:*",
    "@iam/domain": "workspace:*",
    "@iam/jobs": "workspace:*",
    "@iam/role-assignment-resolution": "workspace:*",
    "@iam/user-profile-read-model": "workspace:*",
    "@scalar/hono-api-reference": "^0.10.20",
    "@trpc/server": "^11.17.0",
    "bcrypt-ts": "^8.0.1",
    "drizzle-orm": "1.0.0-rc.2",
    "hono": "^4.12.23",
    "hono-pino": "^0.10.3",
    "ioredis": "^5.11.0",
    "pino": "^10.3.1",
    "postgres": "^3.4.9",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@antfu/eslint-config": "^9.0.0",
    "@types/bun": "latest",
    "@typescript/native-preview": "7.0.0-dev.20260603.1",
    "eslint": "^10.4.1",
    "eslint-plugin-format": "^2.0.1",
    "typescript": "^6.0.3"
  }
}
