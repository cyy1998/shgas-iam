{
  "name": "@iam/admin-api",
  "type": "module",
  "version": "1.0.0",
  "private": true,
  "exports": {
    ".": "./src/app.ts",
    "./trpc": "./src/trpc/trpc.router.ts"
  },
  "module": "index.ts",
  "devEngines": {
    "runtime": {
      "name": "bun"
    }
  },
  "scripts": {
    "dev": "bun --hot src/index.ts",
    "serve": "bun run src/index.ts",
    "lint": "eslint src/",
    "lint:fix": "eslint --fix src/",
    "typecheck": "pnpm exec tsgo --noEmit"
  },
  "dependencies": {
    "@hono/zod-openapi": "^1.1.4",
    "@iam/api-core": "workspace:*",
    "@iam/contracts": "workspace:*",
    "@iam/db": "workspace:*",
    "@scalar/hono-api-reference": "^0.10.7",
    "@trpc/server": "^11.16.0",
    "bcrypt-ts": "^7.1.0",
    "drizzle-orm": "1.0.0-rc.1",
    "hono": "^4.12.8",
    "hono-pino": "^0.10.3",
    "ioredis": "^5.8.1",
    "pino": "^10.3.1",
    "pino-pretty": "^13.1.3",
    "postgres": "^3.4.9",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@antfu/eslint-config": "^8.0.0",
    "@types/bun": "latest",
    "@typescript/native-preview": "7.0.0-dev.20260504.1",
    "eslint": "^10.0.0",
    "eslint-plugin-format": "^2.0.1",
    "typescript": "^6.0.3"
  }
}
