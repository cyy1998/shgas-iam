{
  "name": "@iam/sso",
  "private": true,
  "author": "cyy",
  "scripts": {
    "build": "max build",
    "dev": "max dev",
    "dev:e2e": "cross-env PORT=8000 UMI_APP_SSO_LOGIN_CREDENTIAL_KID=2026-05-primary UMI_APP_SSO_LOGIN_CREDENTIAL_PUBLIC_KEY=04112ddd8854e8262db2520bba112535844884c03348a45fcf4ee0f9a967979be52bd46caf43be697ae557ed2e4fa5b4dca8d2dbfa08c0f2f710c0f61591bb17dc max dev",
    "e2e:install": "playwright install --with-deps chromium",
    "e2e:install:browsers": "playwright install chromium",
    "e2e:ui": "playwright test --ui",
    "format": "node ../../scripts/run-quality.mjs format --workspace apps/sso",
    "postinstall": "max setup",
    "lint": "node ../../scripts/run-quality.mjs lint --workspace apps/sso",
    "format:check": "node ../../scripts/run-quality.mjs format-check --workspace apps/sso",
    "lint:fix": "node ../../scripts/run-quality.mjs lint-fix --workspace apps/sso",
    "typecheck": "pnpm exec tsc --noEmit",
    "setup": "max setup",
    "start": "npm run dev",
    "test": "pnpm test:unit",
    "test:coverage": "vitest run --config vitest.unit.config.ts --coverage",
    "test:integration:browser": "node ../../scripts/playwright-e2e-preflight.mjs && playwright test",
    "test:integration:component": "vitest run --config vitest.integration.component.config.ts",
    "test:unit": "vitest run --config vitest.unit.config.ts",
    "test:watch": "vitest --config vitest.unit.config.ts"
  },
  "dependencies": {
    "@ant-design/cssinjs": "^2.1.2",
    "@ant-design/icons": "^6.3.4",
    "@iam/contracts": "workspace:*",
    "@iam/custom-sso": "workspace:*",
    "@umijs/max": "^4.6.79",
    "antd": "^6.5.1",
    "cap-widget": "^0.1.57",
    "react": "^19.2.7",
    "react-dom": "^19.2.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.1",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.1",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@typescript/native": "npm:typescript@7.0.2",
    "@vitest/coverage-v8": "5.0.1",
    "cross-env": "^10.1.0",
    "jsdom": "^30.1.0",
    "msw": "^2.15.0",
    "typescript": "npm:@typescript/typescript6@6.0.2",
    "vitest": "5.0.1"
  }
}
