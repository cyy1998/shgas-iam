{
  "name": "@iam/sso",
  "private": true,
  "author": "cyy",
  "scripts": {
    "build": "max build",
    "dev": "max dev",
    "dev:e2e": "cross-env PORT=8000 UMI_APP_SSO_LOGIN_CREDENTIAL_KID=2026-05-primary UMI_APP_SSO_LOGIN_CREDENTIAL_PUBLIC_KEY=04112ddd8854e8262db2520bba112535844884c03348a45fcf4ee0f9a967979be52bd46caf43be697ae557ed2e4fa5b4dca8d2dbfa08c0f2f710c0f61591bb17dc max dev",
    "e2e": "node ../../scripts/playwright-e2e-preflight.mjs && playwright test",
    "e2e:install": "playwright install --with-deps chromium",
    "e2e:install:browsers": "playwright install chromium",
    "e2e:ui": "playwright test --ui",
    "format": "prettier --cache --write .",
    "postinstall": "max setup",
    "lint": "pnpm run lint:eslint && pnpm run lint:style",
    "lint:eslint": "eslint \"{src,test,e2e}/**/*.{js,jsx,ts,tsx}\" \".eslintrc.js\" \".stylelintrc.js\" \".umirc.ts\" \"playwright.config.ts\" \"vitest.config.ts\" \"typings.d.ts\" --ignore-pattern \"!.stylelintrc.js\" --ignore-pattern \"!.umirc.ts\"",
    "lint:fix": "pnpm run lint:eslint -- --fix && pnpm run lint:style -- --fix",
    "lint:style": "stylelint \"{src,test}/**/*.{less,css}\"",
    "setup": "max setup",
    "start": "npm run dev",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest",
    "typecheck": "pnpm exec tsgo --noEmit"
  },
  "dependencies": {
    "@ant-design/cssinjs": "^1.24.0",
    "@ant-design/icons": "^6.2.5",
    "@ant-design/pro-components": "^2.8.10",
