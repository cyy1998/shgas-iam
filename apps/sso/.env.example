# 开发服务器端口
PORT=8000

# 后端 API 前缀（本地 Umi proxy 和 APISIX/生产网关均支持此前缀）
UMI_APP_API_PREFIX=/api/iam

# SSO 客户端代码（与后端 client 字段对应）
UMI_APP_SSO_CLIENT_CODE=iam

# Cap 人机校验配置
UMI_APP_CAP_SITE_KEY=iam-sso
UMI_APP_CAP_ENDPOINT=/api/iam/open/cap/iam-sso/
UMI_APP_CAP_WASM_URL=/portal/cap/cap_wasm_bg.wasm
UMI_APP_CAP_PAKO_URL=/portal/cap/pako_inflate.min.js

# /.well-known/authentication-configuration 端点（默认走同域 proxy）
UMI_APP_WELL_KNOWN_URL=/sso/.well-known/authentication-configuration
