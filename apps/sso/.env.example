# 仅填写本机资源、密钥和常用开关；注释项为可选覆盖，默认值以 src/constants/config.ts 为准。
# 开发服务器端口
PORT=8000

# 后端 API 前缀（本地 Vite proxy 和 APISIX/生产网关均支持此前缀）
IAM_SSO_WEB_API_PREFIX=/api/iam

# SSO 客户端代码（与后端 client 字段对应）
IAM_SSO_WEB_CLIENT_CODE=iam

# Cap 人机校验配置
IAM_SSO_WEB_CAP_SITE_KEY=iam-sso
# 默认由 API_PREFIX 与 CAP_SITE_KEY 派生；仅覆盖独立 Cap 地址时设置。
# IAM_SSO_WEB_CAP_ENDPOINT=/api/iam/open/cap/iam-sso/
# IAM_SSO_WEB_CAP_WASM_URL=/portal/cap/cap_wasm_bg.wasm
# IAM_SSO_WEB_CAP_PAKO_URL=/portal/cap/pako_inflate.min.js

# 密码登录国密加密凭证配置
IAM_SSO_WEB_LOGIN_CREDENTIAL_KID=2026-05-primary
IAM_SSO_WEB_LOGIN_CREDENTIAL_PUBLIC_KEY=04112ddd8854e8262db2520bba112535844884c03348a45fcf4ee0f9a967979be52bd46caf43be697ae557ed2e4fa5b4dca8d2dbfa08c0f2f710c0f61591bb17dc

# /.well-known/authentication-configuration 端点（默认走同域 proxy）
# IAM_SSO_WEB_WELL_KNOWN_URL=/sso/.well-known/authentication-configuration
