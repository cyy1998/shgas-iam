{
  "compilerOptions": {
    "target": "ESNext",
    "lib": ["DOM", "DOM.Iterable", "ESNext"],
    "module": "Preserve",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "types": ["vite/client", "node"],
    "noEmit": true,
    "strict": true,
    "skipLibCheck": true,
    "paths": {
      "@admin/*": ["./src/*"],
      "~admin/*": ["./*"],
      "@admin-api/*": ["../admin-api/src/*"],
      "~admin-api/*": ["../admin-api/*"],
      "@api/*": ["../api/src/*"],
      "~api/*": ["../api/*"]
    }
  },
  "include": ["src", "test", "test-integration", "scripts", "*.ts"]
}
