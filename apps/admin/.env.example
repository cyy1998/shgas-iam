# 仅填写本机资源、密钥和常用开关；注释项为可选覆盖，默认值以 src/constants/config.ts 为准。
# Admin 前端环境变量示例。
# 复制此文件为 .env.local 进行本地覆盖（.env.local 不会被提交）。
# Vite 仅向浏览器注入下列 IAM_ADMIN_WEB_ 构建变量。

# 开发服务器端口
PORT=8001

# 后端 API 前缀（本地 Vite proxy 和 APISIX/生产网关均支持此前缀）
IAM_ADMIN_WEB_API_PREFIX=/api/iam

# SSO 授权端点 URL
# IAM_ADMIN_WEB_SSO_AUTHORIZE_URL=/sso/authorize

# SSO 登出端点 URL
# IAM_ADMIN_WEB_SSO_LOGOUT_URL=/sso/logout

# 当前应用在 SSO 系统中注册的 client code
IAM_ADMIN_WEB_CLIENT_CODE=iam-admin

# Grafana 系统日志入口
IAM_ADMIN_WEB_GRAFANA_URL=http://localhost:30030
# IAM_ADMIN_WEB_SYSTEM_LOG_ENV=dev
