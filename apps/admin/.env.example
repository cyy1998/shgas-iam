# Admin 前端环境变量示例。
# 复制此文件为 .env.local 进行本地覆盖（.env.local 不会被提交）。
# UMI Max 仅注入 UMI_APP_ 前缀的环境变量到客户端代码中。

# 开发服务器端口
PORT=8001

# 后端 API 前缀（本地 Umi proxy 和 APISIX/生产网关均支持此前缀）
UMI_APP_API_PREFIX=/api/iam

# SSO 授权端点 URL
UMI_APP_SSO_AUTHORIZE_URL=/sso/authorize

# SSO 登出端点 URL
UMI_APP_SSO_LOGOUT_URL=/sso/logout

# 当前应用在 SSO 系统中注册的 client code
UMI_APP_SSO_CLIENT_CODE=iam-admin

# 允许访问管理后台的角色码
UMI_APP_ADMIN_ROLE_CODE=iam:admin
