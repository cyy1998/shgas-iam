{
  "name": "@iam/admin",
  "private": true,
  "author": "cyy",
  "scripts": {
    "build": "max build",
    "dev": "max dev",
    "dev:e2e": "cross-env PORT=8001 max dev",
    "e2e:install": "playwright install --with-deps chromium",
    "e2e:install:browsers": "playwright install chromium",
    "e2e:ui": "playwright test --ui",
    "format": "prettier --cache --write .",
    "postinstall": "max setup",
    "lint": "pnpm run lint:eslint && pnpm run lint:style",
    "lint:eslint": "eslint src test test-integration .umirc.ts playwright.config.ts vitest.shared.ts vitest.unit.config.ts vitest.integration.component.config.ts typings.d.ts eslint.config.mjs stylelint.config.mjs",
    "lint:fix": "pnpm run lint:eslint -- --fix && pnpm run lint:style -- --fix",
    "lint:style": "stylelint \"{src,test}/**/*.{less,css}\"",
    "setup": "max setup",
    "start": "npm run dev",
    "test": "pnpm test:unit",
    "test:coverage": "vitest run --config vitest.unit.config.ts --coverage",
    "test:integration:browser": "node ../../scripts/playwright-e2e-preflight.mjs && playwright test",
    "test:integration:component": "vitest run --config vitest.integration.component.config.ts",
    "test:unit": "vitest run --config vitest.unit.config.ts",
    "test:watch": "vitest --config vitest.unit.config.ts",
    "typecheck": "pnpm exec tsc --noEmit"
  },
  "dependencies": {
    "@ant-design/icons": "^6.3.2",
    "@ant-design/pro-components": "3.1.14-2",
    "@iam/client-subject-projection": "workspace:*",
    "@iam/contracts": "workspace:*",
    "@trpc/client": "^11.18.0",
    "@trpc/server": "^11.18.0",
    "@umijs/max": "^4.6.79",
    "antd": "^6.5.1",
    "react": "^19.2.7",
    "react-dom": "^19.2.7"
  },
  "devDependencies": {
    "@iam/admin-api": "workspace:*",
    "@iam/eslint-config": "workspace:*",
    "@playwright/test": "^1.61.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/jsdom": "^28.0.3",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@typescript/native": "npm:typescript@7.0.2",
    "@vitest/coverage-v8": "4.1.10",
    "cross-env": "^10.1.0",
    "eslint": "^10.7.0",
    "jsdom": "^29.1.1",
    "msw": "^2.15.0",
    "postcss-less": "^6.0.0",
    "prettier": "^3.9.5",
    "prettier-plugin-organize-imports": "^4.3.0",
    "prettier-plugin-packagejson": "^3.0.2",
    "stylelint": "^17.14.0",
    "stylelint-config-standard": "^40.0.0",
    "typescript": "npm:@typescript/typescript6@6.0.2",
    "vitest": "4.1.10"
  }
}
