{
  "name": "@iam/admin",
  "private": true,
  "author": "cyy",
  "scripts": {
    "build": "max build",
    "dev": "max dev",
    "dev:e2e": "cross-env PORT=8001 max dev",
    "e2e:install": "playwright install --with-deps chromium",
    "e2e:install:browsers": "playwright install chromium",
    "e2e:ui": "playwright test --ui",
    "format": "node ../../scripts/run-quality.mjs format --workspace apps/admin",
    "postinstall": "max setup",
    "lint": "node ../../scripts/run-quality.mjs lint --workspace apps/admin",
    "format:check": "node ../../scripts/run-quality.mjs format-check --workspace apps/admin",
    "lint:fix": "node ../../scripts/run-quality.mjs lint-fix --workspace apps/admin",
    "typecheck": "pnpm exec tsc --noEmit",
    "setup": "max setup",
    "start": "npm run dev",
    "test": "pnpm test:unit",
    "test:coverage": "vitest run --config vitest.unit.config.ts --coverage",
    "test:integration:browser": "node ../../scripts/playwright-e2e-preflight.mjs && playwright test",
    "test:integration:component": "vitest run --config vitest.integration.component.config.ts",
    "test:unit": "vitest run --config vitest.unit.config.ts",
    "test:watch": "vitest --config vitest.unit.config.ts"
  },
  "dependencies": {
    "@ant-design/icons": "^6.3.4",
    "@ant-design/pro-components": "3.1.14-2",
    "@iam/client-subject-projection": "workspace:*",
    "@iam/contracts": "workspace:*",
    "@iam/custom-sso": "workspace:*",
    "@trpc/client": "^11.18.0",
    "@trpc/server": "^11.18.0",
    "@umijs/max": "^4.6.79",
    "antd": "^6.5.1",
    "react": "^19.2.7",
    "react-dom": "^19.2.7"
  },
  "devDependencies": {
    "@iam/admin-api": "workspace:*",
    "@playwright/test": "^1.61.1",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.1",
    "@types/jsdom": "^30.0.0",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@typescript/native": "npm:typescript@7.0.2",
    "@vitest/coverage-v8": "5.0.1",
    "cross-env": "^10.1.0",
    "jsdom": "^30.1.0",
    "msw": "^2.15.0",
    "typescript": "npm:@typescript/typescript6@6.0.2",
    "vitest": "5.0.1"
  }
}
