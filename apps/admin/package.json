{
  "name": "@iam/admin",
  "private": true,
  "author": "cyy",
  "scripts": {
    "build": "max build",
    "dev": "max dev",
    "dev:e2e": "cross-env PORT=8001 max dev",
    "e2e": "playwright test",
    "e2e:ui": "playwright test --ui",
    "format": "prettier --cache --write .",
    "postinstall": "max setup",
    "lint": "pnpm run lint:eslint && pnpm run lint:style",
    "lint:eslint": "eslint \"{src,test}/**/*.{js,jsx,ts,tsx}\"",
    "lint:fix": "pnpm run lint:eslint -- --fix && pnpm run lint:style -- --fix",
    "lint:style": "stylelint \"{src,test}/**/*.{less,css}\"",
    "setup": "max setup",
    "start": "npm run dev",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest",
    "typecheck": "pnpm exec tsgo --noEmit"
  },
  "dependencies": {
    "@ant-design/icons": "^6.2.5",
    "@ant-design/pro-components": "^2.8.10",
    "@iam/contracts": "workspace:*",
    "@trpc/client": "^11.17.0",
    "@trpc/server": "^11.17.0",
    "@umijs/max": "^4.6.58",
    "antd": "^5.29.3",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@iam/admin-api": "workspace:*",
    "@playwright/test": "^1.61.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/react": "^18.3.30",
    "@types/react-dom": "^18.3.7",
    "@typescript/native-preview": "7.0.0-dev.20260603.1",
    "@vitest/coverage-v8": "0.34.6",
    "cross-env": "^10.1.0",
    "eslint": "8.35.0",
    "jsdom": "^29.1.1",
    "lint-staged": "^17.0.7",
    "msw": "^2.14.6",
    "prettier": "^3.8.3",
    "prettier-plugin-organize-imports": "^4.3.0",
    "prettier-plugin-packagejson": "^3.0.2",
    "stylelint": "14.8.2",
    "typescript": "^6.0.3",
    "vitest": "0.34.6"
  }
}
