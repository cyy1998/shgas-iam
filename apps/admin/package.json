{
  "name": "@iam/admin",
  "private": true,
  "author": "cyy",
  "scripts": {
    "build": "vite build",
    "dev": "vite",
    "dev:e2e": "vite --host 127.0.0.1 --port 8001",
    "e2e:install": "playwright install --with-deps chromium",
    "e2e:install:browsers": "playwright install chromium",
    "e2e:ui": "playwright test --ui",
    "format": "biome format --write . && prettier \"**/*.{less,md,yaml,yml}\" --ignore-path ../../.gitignore --ignore-path ../../.prettierignore --no-error-on-unmatched-pattern --write",
    "lint": "biome check --formatter-enabled=false . && stylelint \"**/*.less\" --allow-empty-input",
    "format:check": "biome format . && prettier \"**/*.{less,md,yaml,yml}\" --ignore-path ../../.gitignore --ignore-path ../../.prettierignore --no-error-on-unmatched-pattern --check",
    "lint:fix": "biome check --formatter-enabled=false --write . && stylelint \"**/*.less\" --allow-empty-input",
    "typecheck": "pnpm exec tsc --noEmit",
    "start": "npm run dev",
    "test": "pnpm test:unit",
    "test:coverage": "vitest run --config vitest.unit.config.ts --coverage",
    "test:integration:playwright": "node ../../scripts/run-package-integration.mjs playwright --preflight ../../scripts/playwright-e2e-preflight.mjs --browser-workers 2 -- playwright test",
    "test:unit": "vitest run --config vitest.unit.config.ts",
    "test:watch": "vitest --config vitest.unit.config.ts"
  },
  "iamTest": {
    "integration": {
      "playwright": {}
    }
  },
  "dependencies": {
    "@ant-design/icons": "^6.3.4",
    "@ant-design/pro-components": "3.1.14-2",
    "@iam/client-subject-projection": "workspace:*",
    "@iam/contracts": "workspace:*",
    "@iam/custom-sso": "workspace:*",
    "@trpc/client": "^11.18.0",
    "@trpc/server": "^11.18.0",
    "antd": "^6.5.1",
    "dayjs": "1.11.21",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-router": "7.18.5",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@iam/admin-api": "workspace:*",
    "@playwright/test": "^1.61.1",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.1",
    "@types/jsdom": "^30.0.0",
    "@types/node": "25.9.1",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@typescript/native": "npm:typescript@7.0.2",
    "@vitejs/plugin-react": "6.3.0",
    "@vitest/coverage-v8": "5.0.1",
    "jsdom": "^30.1.0",
    "less": "4.6.7",
    "msw": "^2.15.0",
    "typescript": "npm:@typescript/typescript6@6.0.2",
    "vite": "8.1.5",
    "vitest": "5.0.1"
  }
}
