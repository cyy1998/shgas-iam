# Copy to apps/ops/.env for source execution. Only the chosen command's resources are required.
NODE_ENV=development
IAM_OPS_DATABASE_URL=postgresql://iam:password@127.0.0.1:5432/iam
IAM_OPS_REDIS_HOST=127.0.0.1
IAM_OPS_REDIS_PORT=6379
IAM_OPS_REDIS_DB=0
IAM_OPS_REDIS_USERNAME=
IAM_OPS_REDIS_PASSWORD=
IAM_OPS_LOG_LEVEL=info
IAM_OPS_LOG_FORMAT=auto
IAM_OPS_USER_DOCUMENT_REBUILD_BATCH_SIZE=100
IAM_OPS_USER_DOCUMENT_BACKFILL_BATCH_SIZE=500
IAM_OPS_USER_DOCUMENT_REPAIR_STALE_SECONDS=300
IAM_OPS_ORGANIZATION_DOCUMENT_BACKFILL_BATCH_SIZE=500
IAM_OPS_ORGANIZATION_DOCUMENT_REPAIR_STALE_SECONDS=300
