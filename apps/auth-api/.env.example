# 仅填写本机资源、密钥和常用开关；注释项为可选覆盖，默认值以 src/env.ts 为准。
# ================================
# IAM Auth API 环境变量配置示例
# ================================

# 数据库配置
IAM_AUTH_API_DATABASE_URL=postgresql://iam:iam_password@localhost:5432/iam_db

# Redis 配置
IAM_AUTH_API_REDIS_URL=redis://localhost:6379/0

# 服务器配置
# IAM_AUTH_API_PORT=30000
# NODE_ENV=development
# IAM_AUTH_API_LOG_LEVEL=info
# IAM_AUTH_API_LOG_FORMAT=auto

# 安全密钥
# IAM_AUTH_API_PASSWORD_HASH_ROUNDS=10
IAM_AUTH_API_MAGIC_CODE=magic-code-for-special-operations

# Cap 人机校验配置
IAM_AUTH_API_CAP_ENABLED=false
IAM_AUTH_API_IMAGE_CAPTCHA_ENABLED=true
IAM_AUTH_API_CAP_SITE_KEY=iam-sso
IAM_AUTH_API_CAP_SECRET=change-me-cap-secret
# IAM_AUTH_API_CAP_CHALLENGE_TTL_MS=600000
# IAM_AUTH_API_CAP_TOKEN_TTL_SECONDS=600
# IAM_AUTH_API_HUMAN_VERIFICATION_WINDOW_SECONDS=600
# IAM_AUTH_API_HUMAN_VERIFICATION_LOGIN_FAILURE_THRESHOLD=3
# IAM_AUTH_API_HUMAN_VERIFICATION_LOOKUP_THRESHOLD=20

# 密码登录国密加密凭证配置
IAM_AUTH_API_LOGIN_CREDENTIAL_ACTIVE_KID=2026-05-primary
IAM_AUTH_API_LOGIN_CREDENTIAL_PRIVATE_KEYS_JSON={"2026-05-primary":"319b4e59ca80d7b4cc35955b63da4edf1ed51772ec8f33c0a4f769dda7b9fc65"}
# IAM_AUTH_API_LOGIN_CREDENTIAL_MAX_SKEW_MS=300000
# IAM_AUTH_API_LOGIN_CREDENTIAL_NONCE_TTL_SECONDS=360

# Unified Session Kernel（内部追加 :unified:v1:；根与应用会话共用下方固定 TTL）
# IAM_AUTH_API_SESSION_KERNEL_NAMESPACE=iam:session

# 企微扫码读取共享的 OIDC 续接状态，命名空间须与 sso-api 一致
# IAM_AUTH_API_OIDC_NAMESPACE=iam:oidc

# 微信企业号集成
IAM_AUTH_API_WECHAT_CORP_ID=your-wechat-corp-id
IAM_AUTH_API_WECHAT_CORP_SECRET=your-wechat-corp-secret
# Set both to enable WeCom QR authentication.
IAM_AUTH_API_WECHAT_QR_AGENT_ID=
IAM_AUTH_API_WECHAT_QR_CALLBACK_URL=

# 短信服务配置
IAM_AUTH_API_SMS_URL=https://sms-service.example.com/api/send
IAM_AUTH_API_SMS_SIGNATURE_KEY=your-sms-signature-key

# Redis 过期时间配置（单位：秒）
# IAM_AUTH_API_USER_SESSION_TTL_SECONDS=86400
# IAM_AUTH_API_CLIENT_SESSION_TTL_SECONDS=86400
# IAM_AUTH_API_CUSTOM_SSO_PROJECTION_RETRY_AFTER_SECONDS=3

# 端点配置
IAM_AUTH_API_SSO_INTERNAL_ORIGIN=http://iam-sso.internal.localhost:30080
IAM_AUTH_API_SSO_EXTERNAL_ORIGIN=http://iam-sso.localhost:30080
