{
  "name": "@iam/worker",
  "type": "module",
  "version": "0.0.1",
  "private": true,
  "exports": {
    ".": "./src/index.ts"
  },
  "module": "index.ts",
  "devEngines": {
    "runtime": {
      "name": "bun",
      "version": "1.3.14"
    }
  },
  "scripts": {
    "dev": "bun --hot src/index.ts",
    "serve": "bun run src/index.ts",
    "user-profile:backfill": "bun run src/commands/user-profile-backfill.ts",
    "user-profile:repair": "bun run src/commands/user-profile-repair.ts",
    "lint": "eslint src eslint.config.js",
    "lint:fix": "eslint --fix src eslint.config.js",
    "test": "bun test --parallel",
    "typecheck": "pnpm exec tsgo --noEmit"
  },
  "dependencies": {
    "@bull-board/api": "^8.0.2",
    "@bull-board/hono": "^8.0.2",
    "@iam/api-core": "workspace:*",
    "@iam/contracts": "workspace:*",
    "@iam/db": "workspace:*",
    "@iam/jobs": "workspace:*",
    "@iam/user-profile-read-model": "workspace:*",
    "drizzle-orm": "1.0.0-rc.2",
    "hono": "^4.12.23",
    "ioredis": "^5.11.0",
    "pino": "^10.3.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@antfu/eslint-config": "^9.0.0",
    "@types/bun": "latest",
    "@typescript/native-preview": "7.0.0-dev.20260603.1",
    "eslint": "^10.4.1",
    "eslint-plugin-format": "^2.0.1",
    "typescript": "^6.0.3"
  }
}
