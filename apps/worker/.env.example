IAM_WORKER_DATABASE_URL=postgresql://iam:password@localhost:5432/iam
IAM_WORKER_REDIS_HOST=localhost
IAM_WORKER_REDIS_PORT=6379
IAM_WORKER_REDIS_PASSWORD=
IAM_WORKER_REDIS_DB=0
NODE_ENV=development
IAM_WORKER_LOG_LEVEL=info
IAM_WORKER_LOG_FORMAT=auto
IAM_WORKER_ENABLED_MODULES=user-profile
IAM_WORKER_HTTP_ENABLED=true
IAM_WORKER_HTTP_PORT=30003
IAM_WORKER_HEALTH_PATH=/healthz
IAM_WORKER_BULL_BOARD_ENABLED=false
IAM_WORKER_BULL_BOARD_PATH=/admin/queues
IAM_WORKER_BULL_BOARD_QUEUES=all
IAM_WORKER_BULL_BOARD_AUTH_ENABLED=true
IAM_WORKER_BULL_BOARD_USERNAME=iam-worker
IAM_WORKER_BULL_BOARD_PASSWORD=iam-worker-dev
IAM_WORKER_BULL_BOARD_READ_ONLY=true
IAM_WORKER_USER_PROFILE_CONCURRENCY=2
IAM_WORKER_USER_PROFILE_REBUILD_BATCH_SIZE=100
IAM_WORKER_USER_PROFILE_BACKFILL_BATCH_SIZE=500
IAM_WORKER_USER_PROFILE_REPAIR_STALE_SECONDS=300
