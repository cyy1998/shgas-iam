# 独立 Gateway API 启动配置；请求变量通过 HTTP variables 显式提交。
IAM_GATEWAY_DATABASE_URL=postgresql://gateway_reader:replace-me@127.0.0.1:5432/iam_db
IAM_GATEWAY_APISIX_ADMIN_URL=http://127.0.0.1:9180/apisix/admin
IAM_GATEWAY_APISIX_ADMIN_KEY=replace-with-admin-key
IAM_GATEWAY_HOSTNAME=0.0.0.0
IAM_GATEWAY_PORT=30004
IAM_GATEWAY_MAX_REQUEST_BYTES=1048576
IAM_GATEWAY_OPERATION_TIMEOUT_MS=60000
IAM_GATEWAY_APISIX_REQUEST_TIMEOUT_MS=10000
IAM_GATEWAY_SHUTDOWN_TIMEOUT_MS=70000
