IAM_OIDC_PROVIDER_DATABASE_URL=postgresql://iam:iam_password@localhost:5432/iam_db
IAM_OIDC_PROVIDER_REDIS_HOST=localhost
IAM_OIDC_PROVIDER_REDIS_PORT=6390
IAM_OIDC_PROVIDER_REDIS_PASSWORD=
IAM_OIDC_PROVIDER_REDIS_DB=0
IAM_OIDC_PROVIDER_PORT=30002
NODE_ENV=development
IAM_OIDC_PROVIDER_LOG_LEVEL=info
IAM_OIDC_PROVIDER_LOG_FORMAT=auto
IAM_OIDC_PROVIDER_ISSUER=http://localhost:30080/oidc
IAM_OIDC_PROVIDER_PUBLIC_ORIGIN=http://localhost:30080
IAM_OIDC_PROVIDER_SSO_LOGIN_PATH=/portal/login
IAM_OIDC_PROVIDER_COOKIE_KEYS=replace-with-at-least-32-characters-primary,replace-with-at-least-32-characters-secondary
IAM_OIDC_PROVIDER_CURRENT_JWK_JSON={"kty":"RSA","kid":"replace-me","alg":"RS256","use":"sig","n":"...","e":"AQAB","d":"...","p":"...","q":"...","dp":"...","dq":"...","qi":"..."}
# 密钥轮换时，previous private JWK 的保留时间不得短于 IAM_OIDC_PROVIDER_ID_TOKEN_TTL_SECONDS。
IAM_OIDC_PROVIDER_PREVIOUS_JWK_JSON=
IAM_OIDC_PROVIDER_GLOBAL_SESSION_COOKIE=global_session
IAM_OIDC_PROVIDER_GLOBAL_SESSION_TTL_SECONDS=86400
IAM_OIDC_PROVIDER_AUTHORIZATION_CODE_TTL_SECONDS=300
IAM_OIDC_PROVIDER_INTERACTION_TTL_SECONDS=600
IAM_OIDC_PROVIDER_ACCESS_TOKEN_TTL_SECONDS=3600
IAM_OIDC_PROVIDER_ID_TOKEN_TTL_SECONDS=3600
IAM_OIDC_PROVIDER_CLIENT_CACHE_TTL_SECONDS=60
IAM_OIDC_PROVIDER_BCRYPT_COST=12
IAM_OIDC_PROVIDER_CLIENT_AUTH_FAILURE_LIMIT=5
IAM_OIDC_PROVIDER_CLIENT_AUTH_FAILURE_WINDOW_SECONDS=60
IAM_OIDC_PROVIDER_TRUST_PROXY=true
IAM_OIDC_PROVIDER_COOKIE_SECURE=false
IAM_OIDC_PROVIDER_SESSION_KERNEL_NAMESPACE=sess:v2:
IAM_OIDC_PROVIDER_SESSION_KERNEL_PRINCIPAL_IDLE_TTL_SECONDS=86400
IAM_OIDC_PROVIDER_SESSION_KERNEL_PRINCIPAL_ABSOLUTE_TTL_SECONDS=86400
IAM_OIDC_PROVIDER_SESSION_KERNEL_TOMBSTONE_TTL_SECONDS=86400
IAM_OIDC_PROVIDER_SESSION_KERNEL_TOMBSTONE_GRACE_SECONDS=300
IAM_OIDC_PROVIDER_SESSION_LOOKUP_HMAC_CURRENT_ID=dev-current
IAM_OIDC_PROVIDER_SESSION_LOOKUP_HMAC_CURRENT_SECRET=replace-with-at-least-32-characters-hmac-secret
IAM_OIDC_PROVIDER_SESSION_LOOKUP_HMAC_PREVIOUS_ID=
IAM_OIDC_PROVIDER_SESSION_LOOKUP_HMAC_PREVIOUS_SECRET=
