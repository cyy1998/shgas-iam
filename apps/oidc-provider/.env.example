DATABASE_URL=postgresql://iam:iam_password@localhost:5432/iam_db
REDIS_URL=localhost
REDIS_PORT=6390
REDIS_DB=0
PORT=30002
NODE_ENV=development
LOG_LEVEL=info
OIDC_ISSUER=http://localhost:30080/oidc
OIDC_PUBLIC_ORIGIN=http://localhost:30080
OIDC_SSO_LOGIN_PATH=/portal/login
OIDC_COOKIE_KEYS=replace-with-at-least-32-characters-primary,replace-with-at-least-32-characters-secondary
OIDC_CURRENT_JWK_JSON={"kty":"RSA","kid":"replace-me","alg":"RS256","use":"sig","n":"...","e":"AQAB","d":"...","p":"...","q":"...","dp":"...","dq":"...","qi":"..."}
# 密钥轮换时，previous private JWK 的保留时间不得短于 OIDC_ID_TOKEN_TTL_SECONDS。
OIDC_PREVIOUS_JWK_JSON=
OIDC_GLOBAL_SESSION_COOKIE=global_session
OIDC_GLOBAL_SESSION_TTL_SECONDS=86400
OIDC_AUTHORIZATION_CODE_TTL_SECONDS=300
OIDC_INTERACTION_TTL_SECONDS=600
OIDC_ACCESS_TOKEN_TTL_SECONDS=3600
OIDC_ID_TOKEN_TTL_SECONDS=3600
OIDC_CLIENT_CACHE_TTL_SECONDS=60
OIDC_BCRYPT_COST=12
OIDC_CLIENT_AUTH_FAILURE_LIMIT=5
OIDC_CLIENT_AUTH_FAILURE_WINDOW_SECONDS=60
OIDC_TRUST_PROXY=true
SESSION_KERNEL_NAMESPACE=sess:v2:
SESSION_KERNEL_PRINCIPAL_IDLE_TTL_SECONDS=86400
SESSION_KERNEL_PRINCIPAL_ABSOLUTE_TTL_SECONDS=86400
SESSION_KERNEL_TOMBSTONE_TTL_SECONDS=86400
SESSION_KERNEL_TOMBSTONE_GRACE_SECONDS=300
SESSION_LOOKUP_HMAC_CURRENT_ID=dev-current
SESSION_LOOKUP_HMAC_CURRENT_SECRET=replace-with-at-least-32-characters-hmac-secret
SESSION_LOOKUP_HMAC_PREVIOUS_ID=
SESSION_LOOKUP_HMAC_PREVIOUS_SECRET=
