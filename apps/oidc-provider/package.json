    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@antfu/eslint-config": "^9.0.0",
    "@types/node": "^24.0.0",
    "@types/oidc-provider": "9.5.0",
    "eslint": "^10.4.1",
