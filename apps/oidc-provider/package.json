{
  "name": "@iam/oidc-provider",
  "type": "module",
  "version": "0.0.1",
  "private": true,
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "custom-sso:grants": "node --import tsx src/commands/custom-sso-grant-command.ts",
    "online-auth:state": "node --import tsx src/commands/online-auth-state-command.ts",
    "dev": "node --watch --import tsx src/index.ts",
    "serve": "node --import tsx src/index.ts",
    "client-protocol:artifacts": "node --env-file-if-exists=.env --import tsx scripts/client-protocol-artifact-maintenance.ts",
    "lint": "eslint src test-integration vitest.unit.config.ts vitest.integration.component.config.ts vitest.integration.composition.config.ts vitest.integration.process.config.ts vitest.integration.redis.config.ts eslint.config.js",
    "lint:fix": "eslint --fix src test-integration vitest.unit.config.ts vitest.integration.component.config.ts vitest.integration.composition.config.ts vitest.integration.process.config.ts vitest.integration.redis.config.ts eslint.config.js",
    "test": "pnpm test:unit",
    "test:integration:component": "vitest run --config vitest.integration.component.config.ts",
    "test:integration:composition": "vitest run --config vitest.integration.composition.config.ts",
    "test:integration:process": "vitest run --config vitest.integration.process.config.ts",
    "test:integration:redis": "vitest run --config vitest.integration.redis.config.ts",
    "test:unit": "vitest run --config vitest.unit.config.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@iam/api-core": "workspace:*",
    "@iam/client-subject-projection": "workspace:*",
    "@iam/contracts": "workspace:*",
    "@iam/db": "workspace:*",
    "@iam/domain": "workspace:*",
    "@iam/session-kernel": "workspace:*",
    "@iam/user-profile-read-model": "workspace:*",
    "bcrypt-ts": "^9.0.1",
    "drizzle-orm": "1.0.0-rc.2",
    "ioredis": "^5.11.1",
    "jose": "^6.1.3",
    "oidc-provider": "9.9.1",
    "pino": "^10.3.1",
    "tsx": "^4.23.1",
    "zod": "^4.4.3",
    "@iam/custom-sso": "workspace:*"
  },
  "devDependencies": {
    "@iam/eslint-config": "workspace:*",
    "@types/node": "24.13.2",
    "@types/oidc-provider": "9.5.0",
    "@typescript/native": "npm:typescript@7.0.2",
    "eslint": "^10.7.0",
    "postgres": "^3.4.9",
    "typescript": "npm:@typescript/typescript6@6.0.2",
    "vitest": "4.1.10"
  }
}
