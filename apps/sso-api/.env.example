NODE_ENV=development
IAM_SSO_API_PORT=30002
IAM_SSO_API_DATABASE_URL=postgresql://iam:change-me@localhost:5432/iam
IAM_SSO_API_REDIS_URL=redis://localhost:6379/0
IAM_SSO_API_LOG_LEVEL=info
IAM_SSO_API_LOG_FORMAT=auto

# Origins must match the trusted entry hosts. Both can use the same origin for local development.
IAM_SSO_API_SSO_INTERNAL_ORIGIN=http://localhost:30002
IAM_SSO_API_SSO_EXTERNAL_ORIGIN=http://localhost:30002
IAM_SSO_API_LOGIN_ENDPOINT=/portal/login
IAM_SSO_API_AUTHORIZATION_ENDPOINT=/sso/authorize
IAM_SSO_API_LOGOUT_ENDPOINT=/sso/logout
IAM_SSO_API_THIRDPARTY_OA_ENDPOINT=/sso/thirdparty/oa
IAM_SSO_API_WECHAT_QR_ENABLED=false

# Keep the session and protocol namespaces aligned with the other IAM runtimes.
IAM_SSO_API_SESSION_KERNEL_NAMESPACE=iam:session
IAM_SSO_API_USER_SESSION_TTL_SECONDS=86400
IAM_SSO_API_CLIENT_SESSION_TTL_SECONDS=86400
IAM_SSO_API_AUTH_CODE_TTL_SECONDS=300
IAM_SSO_API_CUSTOM_SSO_TOKEN_TTL_SECONDS=86400
IAM_SSO_API_CUSTOM_SSO_PROJECTION_RETRY_AFTER_SECONDS=3

# Supply an RS256 private JWK with kid, alg and use. The previous key is optional.
IAM_SSO_API_OIDC_CURRENT_JWK_JSON=
IAM_SSO_API_OIDC_PREVIOUS_JWK_JSON=
IAM_SSO_API_OIDC_NAMESPACE=iam:oidc
IAM_SSO_API_OIDC_TRUST_PROXY=true
IAM_SSO_API_OIDC_AUTHORIZATION_CODE_TTL_SECONDS=300
IAM_SSO_API_OIDC_CONTINUATION_TTL_SECONDS=600
IAM_SSO_API_OIDC_TOKEN_TTL_SECONDS=3600
IAM_SSO_API_OIDC_LOGOUT_CONFIRMATION_TTL_SECONDS=600
# Defaults to true in production and false in development.
IAM_SSO_API_OIDC_COOKIE_SECURE=
