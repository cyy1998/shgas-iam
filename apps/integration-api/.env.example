NODE_ENV=development
IAM_INTEGRATION_API_PORT=30005
IAM_INTEGRATION_API_DATABASE_URL=postgresql://iam:change-me@localhost:5432/iam
IAM_INTEGRATION_API_REDIS_URL=redis://localhost:6379/0
IAM_INTEGRATION_API_LOG_LEVEL=info
IAM_INTEGRATION_API_LOG_FORMAT=auto

# Match the shared Redis database and Session Kernel settings used by auth-api and sso-api.
IAM_INTEGRATION_API_SESSION_KERNEL_NAMESPACE=iam:session
IAM_INTEGRATION_API_USER_SESSION_TTL_SECONDS=86400
IAM_INTEGRATION_API_CLIENT_SESSION_TTL_SECONDS=86400

# Required in production for synchronous purveyor contact welcome SMS.
IAM_INTEGRATION_API_SMS_URL=
IAM_INTEGRATION_API_SMS_SIGNATURE_KEY=
