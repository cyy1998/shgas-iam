{
  "name": "@iam/api",
  "type": "module",
  "version": "1.0.0",
  "private": true,
  "exports": {
    ".": "./src/app.ts"
  },
  "module": "index.ts",
  "devEngines": {
    "runtime": {
      "name": "bun",
      "version": "1.4.2"
    }
  },
  "scripts": {
    "dev": "bun --hot src/index.ts",
    "serve": "bun run src/index.ts",
    "lint": "biome check --formatter-enabled=false . && stylelint \"**/*.less\" --allow-empty-input",
    "lint:fix": "biome check --formatter-enabled=false --write . && stylelint \"**/*.less\" --allow-empty-input",
    "db:generate": "pnpm --filter @iam/db db:generate",
    "db:migrate": "pnpm --filter @iam/db db:migrate",
    "db:push": "pnpm --filter @iam/db db:push",
    "test": "pnpm test:unit",
    "test:unit": "bun test --max-concurrency=2 src",
    "typecheck": "pnpm exec tsc --noEmit",
    "format": "biome format --write . && prettier \"**/*.{less,md,yaml,yml}\" --ignore-path ../../.gitignore --ignore-path ../../.prettierignore --no-error-on-unmatched-pattern --write",
    "format:check": "biome format . && prettier \"**/*.{less,md,yaml,yml}\" --ignore-path ../../.gitignore --ignore-path ../../.prettierignore --no-error-on-unmatched-pattern --check",
    "test:integration:bun": "node ../../scripts/run-package-integration.mjs bun -- bun test test-integration",
    "test:integration:playwright": "node ../../scripts/run-package-integration.mjs playwright -- playwright test"
  },
  "dependencies": {
    "@cap.js/server": "^4.0.5",
    "@hono/zod-openapi": "^1.5.1",
    "@iam/api-core": "workspace:*",
    "@iam/client-subject-projection": "workspace:*",
    "@iam/contracts": "workspace:*",
    "@iam/custom-sso": "workspace:*",
    "@iam/db": "workspace:*",
    "@iam/domain": "workspace:*",
    "@iam/filter-engine": "workspace:*",
    "@iam/jobs": "workspace:*",
    "@iam/oidc": "workspace:*",
    "@iam/organization-search-read-model": "workspace:*",
    "@iam/role-assignment-resolution": "workspace:*",
    "@iam/session-kernel": "workspace:*",
    "@iam/user-profile-read-model": "workspace:*",
    "@scalar/hono-api-reference": "^0.11.11",
    "@trpc/server": "^11.18.0",
    "bcrypt": "^6.0.0",
    "bcrypt-ts": "^9.0.2",
    "drizzle-orm": "1.0.0-rc.2",
    "hono": "^4.12.30",
    "hono-pino": "^0.10.3",
    "ioredis": "^6.0.0",
    "p-limit": "^7.3.3",
    "pino": "^10.3.1",
    "postgres": "^3.4.9",
    "sm-crypto": "^0.4.0",
    "ts-enum-util": "^4.1.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.1",
    "@types/bun": "latest",
    "@types/sm-crypto": "^0.3.4",
    "@typescript/native": "npm:typescript@7.0.2",
    "drizzle-kit": "1.0.0-rc.2",
    "openid-client": "6.8.8",
    "tsx": "4.23.15",
    "typescript": "npm:@typescript/typescript6@6.0.2"
  },
  "iamTest": {
    "integration": {
      "bun": {
        "postgres": "IAM_API_TEST_DATABASE_URL",
        "redis": "IAM_API_TEST_REDIS_URL"
      },
      "playwright": {
        "redis": "IAM_API_TEST_REDIS_URL"
      }
    }
  }
}
