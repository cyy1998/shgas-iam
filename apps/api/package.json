{
  "name": "@iam/api",
  "type": "module",
  "version": "1.0.0",
  "private": true,
  "exports": {
    ".": "./src/app.ts"
  },
  "module": "index.ts",
  "devEngines": {
    "runtime": {
      "name": "bun",
      "version": "1.3.14"
    }
  },
  "scripts": {
    "dev": "bun --hot src/index.ts",
    "serve": "bun run src/index.ts",
    "lint": "eslint src/",
    "lint:fix": "eslint --fix src/",
    "db:generate": "pnpm --filter @iam/db db:generate",
    "db:migrate": "pnpm --filter @iam/db db:migrate",
    "db:push": "pnpm --filter @iam/db db:push",
    "migrate:mysql-to-postgres": "bun scripts/migrate-mysql-to-postgres.ts",
    "typecheck": "pnpm exec tsgo --noEmit"
  },
  "dependencies": {
    "@hono/zod-openapi": "^1.4.0",
    "@iam/api-core": "workspace:*",
    "@iam/contracts": "workspace:*",
    "@iam/db": "workspace:*",
    "@scalar/hono-api-reference": "^0.10.16",
    "@trpc/server": "^11.17.0",
    "bcrypt": "^6.0.0",
    "bcrypt-ts": "^8.0.1",
    "csv-parse": "^6.2.1",
    "csv-parser": "^3.2.1",
    "drizzle-orm": "1.0.0-rc.2",
    "hono": "^4.12.18",
    "hono-pino": "^0.10.3",
    "ioredis": "^5.10.1",
    "mysql2": "^3.22.3",
    "p-limit": "^7.3.0",
    "pino": "^10.3.1",
    "pino-pretty": "^13.1.3",
    "postgres": "^3.4.9",
    "sm-crypto": "^0.4.0",
    "ts-enum-util": "^4.1.0",
    "xlsx": "^0.18.5",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@antfu/eslint-config": "^9.0.0",
    "@types/bun": "latest",
    "@types/sm-crypto": "^0.3.4",
    "@typescript/native-preview": "7.0.0-dev.20260514.1",
    "drizzle-kit": "1.0.0-rc.2",
    "eslint": "^10.3.0",
    "eslint-plugin-format": "^2.0.1",
    "typescript": "^6.0.3"
  }
}
