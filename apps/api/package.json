{
  "name": "@iam/api",
  "type": "module",
  "version": "1.0.0",
  "private": true,
  "exports": {
    ".": "./src/app.ts"
  },
  "module": "index.ts",
  "devEngines": {
    "runtime": {
      "name": "bun",
      "version": "1.3.14"
    }
  },
  "scripts": {
    "dev": "bun --hot src/index.ts",
    "serve": "bun run src/index.ts",
    "lint": "eslint src test-integration app.config.ts playwright.config.ts eslint.config.js",
    "lint:fix": "eslint --fix src test-integration app.config.ts playwright.config.ts eslint.config.js",
    "db:generate": "pnpm --filter @iam/db db:generate",
    "db:migrate": "pnpm --filter @iam/db db:migrate",
    "db:push": "pnpm --filter @iam/db db:push",
    "test": "pnpm test:unit",
    "test:integration:component": "bun test --max-concurrency=2 test-integration/component",
    "test:integration:composition": "bun test --max-concurrency=1 test-integration/composition",
    "test:integration:postgres": "bun test --max-concurrency=1 test-integration/postgres",
    "test:integration:process": "bun test --max-concurrency=1 test-integration/process",
    "test:integration:redis": "bun test --max-concurrency=1 test-integration/redis",
    "test:integration:browser": "playwright test",
    "test:unit": "bun test --max-concurrency=2 src",
    "typecheck": "pnpm exec tsc --noEmit"
  },
  "dependencies": {
    "@cap.js/server": "^4.0.5",
    "@hono/zod-openapi": "^1.5.1",
    "@iam/api-core": "workspace:*",
    "@iam/client-subject-projection": "workspace:*",
    "@iam/contracts": "workspace:*",
    "@iam/custom-sso": "workspace:*",
    "@iam/db": "workspace:*",
    "@iam/domain": "workspace:*",
    "@iam/jobs": "workspace:*",
    "@iam/oidc": "workspace:*",
    "@iam/role-assignment-resolution": "workspace:*",
    "@iam/session-kernel": "workspace:*",
    "@iam/user-profile-read-model": "workspace:*",
    "@scalar/hono-api-reference": "^0.11.11",
    "@trpc/server": "^11.18.0",
    "bcrypt": "^6.0.0",
    "bcrypt-ts": "^9.0.1",
    "drizzle-orm": "1.0.0-rc.2",
    "hono": "^4.12.30",
    "hono-pino": "^0.10.3",
    "ioredis": "^5.11.1",
    "p-limit": "^7.3.0",
    "pino": "^10.3.1",
    "postgres": "^3.4.9",
    "sm-crypto": "^0.4.0",
    "ts-enum-util": "^4.1.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@iam/eslint-config": "workspace:*",
    "@playwright/test": "^1.61.1",
    "@types/bun": "latest",
    "@types/sm-crypto": "^0.3.4",
    "@typescript/native": "npm:typescript@7.0.2",
    "drizzle-kit": "1.0.0-rc.2",
    "eslint": "^10.7.0",
    "openid-client": "6.8.1",
    "tsx": "4.23.1",
    "typescript": "npm:@typescript/typescript6@6.0.2"
  }
}
