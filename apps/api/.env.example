# ================================
# IAM API 环境变量配置示例
# ================================

# 数据库配置
IAM_API_DATABASE_URL=postgresql://iam:iam_password@localhost:5432/iam_db

# Redis 配置
IAM_API_REDIS_HOST=localhost
IAM_API_REDIS_PORT=6379
IAM_API_REDIS_PASSWORD=
IAM_API_REDIS_DB=0

# 服务器配置
IAM_API_PORT=30000
NODE_ENV=development
IAM_API_LOG_LEVEL=info
IAM_API_LOG_FORMAT=auto

# 安全密钥
IAM_API_PASSWORD_HASH_ROUNDS=10
IAM_API_MAGIC_CODE=magic-code-for-special-operations

# Cap 人机校验配置
IAM_API_CAP_ENABLED=false
IAM_API_CAP_SITE_KEY=iam-sso
IAM_API_CAP_SECRET=change-me-cap-secret
IAM_API_CAP_CHALLENGE_TTL_MS=600000
IAM_API_CAP_TOKEN_TTL_SECONDS=600
IAM_API_HUMAN_VERIFICATION_WINDOW_SECONDS=600
IAM_API_HUMAN_VERIFICATION_LOGIN_FAILURE_THRESHOLD=3
IAM_API_HUMAN_VERIFICATION_LOOKUP_THRESHOLD=20

# 密码登录国密加密凭证配置
IAM_API_LOGIN_CREDENTIAL_ACTIVE_KID=2026-05-primary
IAM_API_LOGIN_CREDENTIAL_PRIVATE_KEYS_JSON={"2026-05-primary":"319b4e59ca80d7b4cc35955b63da4edf1ed51772ec8f33c0a4f769dda7b9fc65"}
IAM_API_LOGIN_CREDENTIAL_MAX_SKEW_MS=300000
IAM_API_LOGIN_CREDENTIAL_NONCE_TTL_SECONDS=360

# Unified Session Kernel（内部追加 :unified:v1:；根与应用会话共用下方固定 TTL）
IAM_API_SESSION_KERNEL_NAMESPACE=iam:session

# API 内的 OIDC 协议；签名配置沿用 RS256 current/previous 私有 JWK，旧 Provider 配置不再读取
IAM_API_OIDC_CURRENT_JWK_JSON=replace-with-current-private-rsa-jwk-json
IAM_API_OIDC_PREVIOUS_JWK_JSON=
IAM_API_OIDC_NAMESPACE=iam:oidc
# 受信代理部署沿用 X-Forwarded-For 首项；直连部署设 false 使用连接地址。
IAM_API_OIDC_TRUST_PROXY=true
IAM_API_OIDC_AUTHORIZATION_CODE_TTL_SECONDS=300
IAM_API_OIDC_CONTINUATION_TTL_SECONDS=600
IAM_API_OIDC_TOKEN_TTL_SECONDS=3600
IAM_API_OIDC_LOGOUT_CONFIRMATION_TTL_SECONDS=600
# 空值按 NODE_ENV 推导；生产环境默认 Secure
IAM_API_OIDC_COOKIE_SECURE=

# 微信企业号集成
IAM_API_WECHAT_CORP_ID=your-wechat-corp-id
IAM_API_WECHAT_CORP_SECRET=your-wechat-corp-secret

# 短信服务配置
IAM_API_SMS_URL=https://sms-service.example.com/api/send
IAM_API_SMS_SIGNATURE_KEY=your-sms-signature-key

# 外部服务配置
IAM_API_ORCAS_URL=https://orcas-service.example.com/api

# Redis 过期时间配置（单位：秒）
IAM_API_USER_SESSION_TTL_SECONDS=86400
IAM_API_CLIENT_SESSION_TTL_SECONDS=86400
# Custom Token 自身签发期限，不用于配置两类会话。
IAM_API_CUSTOM_SSO_TOKEN_TTL_SECONDS=86400
IAM_API_AUTH_CODE_TTL_SECONDS=300
IAM_API_CUSTOM_SSO_PROJECTION_RETRY_AFTER_SECONDS=3

# 端点配置
IAM_API_LOGIN_ENDPOINT=/portal/login
IAM_API_SSO_INTERNAL_ORIGIN=http://iam-sso.internal.localhost:30080
IAM_API_SSO_EXTERNAL_ORIGIN=http://iam-sso.localhost:30080
IAM_API_AUTHORIZATION_ENDPOINT=/sso/authorize
IAM_API_LOGOUT_ENDPOINT=/sso/logout
IAM_API_THIRDPARTY_OA_ENDPOINT=/sso/thirdparty/oa
