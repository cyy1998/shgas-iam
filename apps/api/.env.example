# ================================
# IAM API 环境变量配置示例
# ================================

# 数据库配置
DATABASE_URL=postgresql://iam:iam_password@localhost:5432/iam_db

# Redis 配置
REDIS_URL=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# 服务器配置
PORT=30000
NODE_ENV=development
LOG_LEVEL=info

# 安全密钥
IAM_SECRET_KEY=your-secret-key-here-change-in-production
PASSWORD_HASH_ROUNDS=10
DEFAULT_USER_PASSWORD=default123
MAGIC_CODE=magic-code-for-special-operations

# Cap 人机校验配置
CAP_ENABLED=false
CAP_SITE_KEY=iam-sso
CAP_SECRET=change-me-cap-secret
CAP_CHALLENGE_TTL_MS=600000
CAP_TOKEN_TTL_SECONDS=600
HUMAN_VERIFICATION_WINDOW_SECONDS=600
HUMAN_VERIFICATION_LOGIN_FAILURE_THRESHOLD=3
HUMAN_VERIFICATION_LOOKUP_THRESHOLD=20

# 微信企业号集成
WX_CORPID=your-wechat-corp-id
WX_CORPSECRET=your-wechat-corp-secret

# 短信服务配置
SMS_URL=https://sms-service.example.com/api/send
SMS_SIGNATURE_KEY=your-sms-signature-key

# 外部服务配置
ORCAS_URL=https://orcas-service.example.com/api
PURVEYOR_PARENT_ORG=供应商父组织ID

# Redis 过期时间配置（单位：秒）
REDIS_EXPIRE_TIME=86400
AUTH_CODE_EXPIRE_TIME=300

# 端点配置
LOGIN_ENDPOINT=http://localhost:8000/portal/login
AUTHORIZATION_ENDPOINT=/sso/authorize
LOGOUT_ENDPOINT=/sso/logout
THIRDPARTY_OA_ENDPOINT=/sso/thirdparty/oa
