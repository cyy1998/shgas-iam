# ================================
# IAM API 环境变量配置示例
# ================================

# 数据库配置
DATABASE_URL=postgresql://iam:iam_password@localhost:5432/iam_db

# Redis 配置
REDIS_URL=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# 服务器配置
PORT=30000
NODE_ENV=development
LOG_LEVEL=info

# 安全密钥
PASSWORD_HASH_ROUNDS=10
MAGIC_CODE=magic-code-for-special-operations

# Cap 人机校验配置
CAP_ENABLED=false
CAP_SITE_KEY=iam-sso
CAP_SECRET=change-me-cap-secret
CAP_CHALLENGE_TTL_MS=600000
CAP_TOKEN_TTL_SECONDS=600
HUMAN_VERIFICATION_WINDOW_SECONDS=600
HUMAN_VERIFICATION_LOGIN_FAILURE_THRESHOLD=3
HUMAN_VERIFICATION_LOOKUP_THRESHOLD=20

# 密码登录国密加密凭证配置
LOGIN_CREDENTIAL_ACTIVE_KID=2026-05-primary
LOGIN_CREDENTIAL_PRIVATE_KEYS_JSON={"2026-05-primary":"319b4e59ca80d7b4cc35955b63da4edf1ed51772ec8f33c0a4f769dda7b9fc65"}
LOGIN_CREDENTIAL_MAX_SKEW_MS=300000
LOGIN_CREDENTIAL_NONCE_TTL_SECONDS=360

# Session Kernel 配置
SESSION_KERNEL_NAMESPACE=sess:v2:
SESSION_KERNEL_PRINCIPAL_IDLE_TTL_SECONDS=86400
SESSION_KERNEL_PRINCIPAL_ABSOLUTE_TTL_SECONDS=86400
SESSION_KERNEL_TOMBSTONE_TTL_SECONDS=86400
SESSION_KERNEL_TOMBSTONE_GRACE_SECONDS=300
SESSION_LOOKUP_HMAC_CURRENT_ID=dev-current
SESSION_LOOKUP_HMAC_CURRENT_SECRET=dev-session-lookup-hmac-secret-32-bytes
SESSION_LOOKUP_HMAC_PREVIOUS_ID=
SESSION_LOOKUP_HMAC_PREVIOUS_SECRET=

# 微信企业号集成
WX_CORPID=your-wechat-corp-id
WX_CORPSECRET=your-wechat-corp-secret

# 短信服务配置
SMS_URL=https://sms-service.example.com/api/send
SMS_SIGNATURE_KEY=your-sms-signature-key

# 外部服务配置
ORCAS_URL=https://orcas-service.example.com/api

# Redis 过期时间配置（单位：秒）
REDIS_EXPIRE_TIME=86400
AUTH_CODE_EXPIRE_TIME=300

# 端点配置
LOGIN_ENDPOINT=http://localhost:8000/portal/login
SSO_INTERNAL_ORIGIN=http://iam-sso.internal.localhost:30080
SSO_EXTERNAL_ORIGIN=http://iam-sso.localhost:30080
AUTHORIZATION_ENDPOINT=/sso/authorize
LOGOUT_ENDPOINT=/sso/logout
THIRDPARTY_OA_ENDPOINT=/sso/thirdparty/oa
