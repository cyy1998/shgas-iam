# Default is ChatGPT file login. Run `codex login` first.
# CODEX_AUTH_FILE defaults to auth.json under CODEX_HOME (default: $HOME/.codex).
# To use API billing, set CODEX_AUTH=api-key and provide CODEX_API_KEY.
CODEX_AUTH=chatgpt
CODEX_API_KEY=
CODEX_AUTH_FILE=
# Authenticate the host with gh auth login or export GH_TOKEN in the host environment.
# Host GitHub credentials require Issues and Pull Requests write access on cyy1998/shgas-iam.
# Keep GitHub credentials outside this file because the planner can read the checkout.

# Defaults to the invocation branch's tracked remote, then origin, then the only configured remote.
SANDCASTLE_GIT_REMOTE=
# true or 1 creates a Draft PR. --draft takes precedence.
SANDCASTLE_PR_DRAFT=false

# Optional GitHub Projects progress view. Each configured stage maps to a single-select option.
# Use the host gh login with project access or export SANDCASTLE_PROJECT_TOKEN in the host process environment.
SANDCASTLE_PROJECT_URL=

# --model / SANDCASTLE_MODEL only overrides the Planner model.
# Other AFK models and reasoning effort come from .codex/agents/*.toml.
# --iterations / SANDCASTLE_ITERATIONS count attempted Specs, including recovery.
# --parallel / SANDCASTLE_PARALLEL bound concurrent ticket implementations within one Spec.
# CLI flags take precedence.
SANDCASTLE_MODEL=gpt-6-astra
SANDCASTLE_ITERATIONS=1
SANDCASTLE_PARALLEL=4
SANDCASTLE_IMAGE=iam-sandcastle:local

# Optional host pnpm store directory (default: $HOME/.pnpm-store), bound to /home/agent/.pnpm-store.
# Relative paths are resolved from the invocation repository root.
SANDCASTLE_PNPM_STORE_DIR=

# Optional JSON file with self-contained auths for the comma-separated registry allowlist.
# Writable-phase executors receive a private readonly copy; credential helpers are unsupported.
SANDCASTLE_DOCKER_CONFIG_FILE=
SANDCASTLE_DOCKER_REGISTRIES=docker.xuanyuan.run
