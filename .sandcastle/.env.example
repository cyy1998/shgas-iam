# Default is ChatGPT file login. Run `codex login` first.
# CODEX_HOME defaults to $HOME/.codex; CODEX_AUTH_FILE defaults to ${CODEX_HOME}/auth.json.
# auth.json is copied one-way readonly into each sandbox (never written back to the host).
# To use API billing, set CODEX_AUTH=api-key and provide CODEX_API_KEY.
CODEX_AUTH=chatgpt
CODEX_API_KEY=
CODEX_HOME=
CODEX_AUTH_FILE=

# Authenticate the host with `gh auth login` or export GH_TOKEN in the host process environment.
# Host GitHub credentials require Issues and Pull Requests write access on cyy1998/shgas-iam.
# IMPORTANT: NEVER place GH_TOKEN or GITHUB_TOKEN in .sandcastle/.env (not even empty keys).
# The Sandcastle SDK resolves declared keys into sandboxes, and core preflightCredentials rejects them.

# Docker sandbox image built by `pnpm sandcastle:build`.
SANDCASTLE_IMAGE=iam-sandcastle:local
# Remote and base branch fetched as new Spec baseline and merge-base reference.
# Defaults to origin and main (set SANDCASTLE_GIT_REMOTE=github if your GitHub remote is named github).
SANDCASTLE_GIT_REMOTE=origin
SANDCASTLE_BASE_BRANCH=main
# --iterations / SANDCASTLE_ITERATIONS count attempted Specs per run (CLI takes precedence).
# --parallel / SANDCASTLE_PARALLEL bound concurrent ticket implementations within one Spec.
# --draft or SANDCASTLE_PR_DRAFT=true (also accepts 1) creates a Draft PR.
SANDCASTLE_ITERATIONS=1
SANDCASTLE_PARALLEL=4
SANDCASTLE_PR_DRAFT=false

# Optional host pnpm store directory (default: $HOME/.pnpm-store), mounted to /home/agent/.pnpm-store.
# Relative paths are resolved from the repository root.
SANDCASTLE_PNPM_STORE_DIR=

# Optional readable Docker registry config JSON (mounted readonly at /home/agent/.docker/config.json).
# Relative paths are resolved from the repository root.
SANDCASTLE_DOCKER_CONFIG_FILE=
