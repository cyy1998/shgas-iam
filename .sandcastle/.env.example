# Default is ChatGPT account login. Run `codex login` first and keep file credential storage enabled.
# Set CODEX_AUTH=api-key only when you intentionally want API billing instead.
CODEX_AUTH=chatgpt
CODEX_API_KEY=
CODEX_AUTH_FILE=
GH_TOKEN=

# --model/SANDCASTLE_MODEL select Planner and final review coordinator only.
# Implementer and review models/effort live in .codex/agents/*.toml.
# --iterations / SANDCASTLE_ITERATIONS count attempted Specs, including resumed Specs.
# --parallel / SANDCASTLE_PARALLEL bound concurrent ticket implementations within one Spec.
# CLI flags override the environment; the defaults are 1 Spec and 4 tickets.
SANDCASTLE_MODEL=gpt-6-astra
SANDCASTLE_ITERATIONS=1
SANDCASTLE_PARALLEL=4
SANDCASTLE_IMAGE=iam-sandcastle:local

# Optional caller-provided JSON file with only self-contained docker.xuanyuan.run auths.
# credsStore/credHelpers/credentialHelpers and other host Docker configuration are unsupported.
# Each executor receives a private readonly copy, removed only after its sandbox is confirmed stopped.
SANDCASTLE_DOCKER_CONFIG_FILE=
