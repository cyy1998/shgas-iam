{
  "name": "@iam/e2e-system",
  "type": "module",
  "version": "0.0.1",
  "private": true,
  "dependencies": {
    "@iam/api-core": "workspace:*",
    "@iam/contracts": "workspace:*",
    "@iam/db": "workspace:*",
    "@iam/domain": "workspace:*",
    "@iam/role-assignment-resolution": "workspace:*",
    "@iam/user-profile-read-model": "workspace:*",
    "drizzle-orm": "1.0.0-rc.2",
    "ioredis": "^6.0.0"
  },
  "scripts": {
    "admin:journey": "bun src/cli.ts admin",
    "hr-admin:journey": "bun src/cli.ts hr-admin",
    "oidc:journey": "bun src/cli.ts oidc",
    "runtime:cleanup": "bun src/cli.ts cleanup",
    "runtime:lifecycle": "bun src/cli.ts run",
    "test:e2e": "bun src/cli.ts e2e",
    "lint": "node ../../scripts/run-quality.mjs lint --workspace e2e/system",
    "lint:fix": "node ../../scripts/run-quality.mjs lint-fix --workspace e2e/system",
    "test": "pnpm test:unit",
    "test:unit": "bun test --max-concurrency=1 src",
    "typecheck": "pnpm exec tsc --noEmit",
    "test:integration:process": "bun test --max-concurrency=1 test-integration/process",
    "format": "node ../../scripts/run-quality.mjs format --workspace e2e/system",
    "format:check": "node ../../scripts/run-quality.mjs format-check --workspace e2e/system"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.1",
    "@types/bun": "latest",
    "@typescript/native": "npm:typescript@7.0.2",
    "typescript": "npm:@typescript/typescript6@6.0.2"
  }
}
