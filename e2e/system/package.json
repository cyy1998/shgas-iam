{
  "name": "@iam/e2e-system",
  "type": "module",
  "version": "0.0.1",
  "private": true,
  "iamWorkspace": {
    "kind": "e2e"
  },
  "dependencies": {
    "@iam/assignment-resolution": "workspace:*",
    "@iam/contracts": "workspace:*",
    "@iam/db": "workspace:*",
    "@iam/documents": "workspace:*",
    "@iam/domain": "workspace:*",
    "@iam/jobs": "workspace:*",
    "@iam/runtime": "workspace:*",
    "@iam/subject-access": "workspace:*",
    "bcrypt-ts": "^9.0.3",
    "drizzle-orm": "1.0.0-rc.2",
    "ioredis": "^6.0.0"
  },
  "scripts": {
    "runtime:cleanup": "bun src/cli.ts cleanup",
    "test:e2e": "bun src/cli.ts e2e",
    "test:e2e:container-smoke": "bun src/cli.ts container-smoke",
    "test:e2e:down": "bun src/cli.ts down",
    "test:e2e:managed": "bun src/cli.ts managed",
    "lint": "biome check --formatter-enabled=false . && stylelint \"**/*.less\" --allow-empty-input",
    "lint:fix": "biome check --formatter-enabled=false --write . && stylelint \"**/*.less\" --allow-empty-input",
    "test": "pnpm test:unit",
    "test:unit": "bun test --max-concurrency=2 src/__tests__",
    "typecheck": "pnpm exec tsc --noEmit",
    "test:integration": "bun src/cli.ts integration",
    "test:frontend:serve": "bun --no-env-file src/frontend/integration-frontend.ts",
    "format": "biome format --write . && prettier \"**/*.{less,md,yaml,yml}\" --ignore-path ../../.gitignore --ignore-path ../../.prettierignore --no-error-on-unmatched-pattern --write",
    "format:check": "biome format . && prettier \"**/*.{less,md,yaml,yml}\" --ignore-path ../../.gitignore --ignore-path ../../.prettierignore --no-error-on-unmatched-pattern --check"
  },
  "devDependencies": {
    "@iam/test-support": "workspace:*",
    "@playwright/test": "^1.65.1",
    "@types/bun": "latest",
    "@typescript/native": "npm:typescript@7.0.2",
    "typescript": "npm:@typescript/typescript6@6.0.2"
  }
}
